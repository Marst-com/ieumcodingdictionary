{
  "schemaVersion": "1.0.0", "language": "java", "type": "type", "entryVersion": "1.0.0",
  "entries": [
    {"id": "java.type.string", "symbol": "String", "name": "String", "aliases": ["문자열", "스트링"], "category": "text", "description": "문자열을 나타내는 불변(immutable) 클래스. 내용 비교는 ==가 아니라 equals()로 합니다.", "syntax": "String NAME = \"TEXT\";", "examples": ["String s = \"hello\";"], "related": ["java.method.string-length", "java.method.string-equals", "java.operator.equal"], "concepts": ["concept.string", "concept.data-type"]},
    {"id": "java.type.object", "symbol": "Object", "name": "Object", "aliases": ["오브젝트", "최상위 클래스"], "category": "core", "description": "모든 클래스의 최상위 부모 클래스. equals(), hashCode(), toString() 같은 공통 메서드를 가집니다.", "syntax": "Object NAME = VALUE;", "examples": ["Object o = \"text\";"], "related": ["java.type.string", "java.keyword.class"], "concepts": ["concept.class", "concept.data-type"]},
    {"id": "java.type.integer", "symbol": "Integer", "name": "Integer", "aliases": ["래퍼 클래스", "박싱", "정수 객체"], "category": "wrapper", "description": "int의 래퍼 클래스. 컬렉션처럼 객체만 담는 곳에서 쓰이며 null이 될 수 있습니다. 값 비교는 equals()를 씁니다.", "syntax": "Integer NAME = VALUE;", "examples": ["Integer n = 5;\nint m = n;"], "related": ["java.keyword.int", "java.method.integer-parseint"], "concepts": ["concept.data-type"]},
    {"id": "java.type.list", "symbol": "List", "name": "List", "aliases": ["리스트", "목록", "인터페이스 리스트"], "category": "collection", "description": "순서가 있는 요소의 모음을 나타내는 인터페이스. 제네릭으로 요소 타입을 지정합니다(List<String>).", "syntax": "List<TYPE> NAME = new ArrayList<>();", "examples": ["List<String> names = new ArrayList<>();"], "related": ["java.type.arraylist", "java.method.list-add", "java.method.list-get"], "concepts": ["concept.collection", "concept.generics"]},
    {"id": "java.type.arraylist", "symbol": "ArrayList", "name": "ArrayList", "aliases": ["배열 리스트", "가변 배열"], "category": "collection", "description": "크기가 자동으로 늘어나는 배열 기반 List 구현체. 인덱스 접근이 빠릅니다.", "syntax": "new ArrayList<>()", "examples": ["List<Integer> nums = new ArrayList<>();\nnums.add(1);"], "related": ["java.type.list", "java.keyword.new"], "concepts": ["concept.collection", "concept.generics"]},
    {"id": "java.type.map", "symbol": "Map", "name": "Map", "aliases": ["맵", "딕셔너리", "키 값 저장", "해시맵"], "category": "collection", "description": "키와 값의 쌍을 저장하는 인터페이스. 키는 중복될 수 없습니다. 대표 구현체는 HashMap입니다.", "syntax": "Map<KEY, VALUE> NAME = new HashMap<>();", "examples": ["Map<String, Integer> ages = new HashMap<>();\nages.put(\"가온\", 20);"], "related": ["java.method.map-put", "java.type.list", "python.function.dict"], "concepts": ["concept.collection", "concept.generics"]},
    {"id": "java.type.optional", "symbol": "Optional", "name": "Optional", "aliases": ["옵셔널", "값이 없을 수 있음", "null 대신"], "category": "core", "description": "값이 있을 수도, 없을 수도 있음을 명시하는 컨테이너. null 반환 대신 사용해 NullPointerException을 줄입니다.", "syntax": "Optional<TYPE> NAME = Optional.of(VALUE);", "examples": ["Optional<String> name = Optional.of(\"가온\");\nString v = name.orElse(\"익명\");"], "related": ["java.type.string"], "concepts": ["concept.null-value", "concept.generics"]},
    {"id": "java.type.math", "symbol": "Math", "name": "Math", "aliases": ["수학 클래스", "수학 함수"], "category": "core", "description": "수학 연산을 제공하는 정적 메서드 모음 클래스(max, min, abs, sqrt, pow 등). 인스턴스를 만들지 않습니다.", "syntax": "Math.METHOD(ARGS)", "examples": ["double r = Math.sqrt(16);"], "related": ["java.method.math-max"], "concepts": ["concept.aggregation"]}
  ]
}
