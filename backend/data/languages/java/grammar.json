{
  "schemaVersion": "1.0.0", "language": "java", "type": "grammar", "entryVersion": "1.0.0",
  "entries": [
    {"id": "java.grammar.class-declaration", "symbol": "class {}", "name": "Class Declaration", "aliases": ["클래스 선언문", "클래스 선언 문법"], "category": "declaration", "description": "접근 제어자, class, 이름, 선택적 extends/implements, 멤버 본문으로 이루어진 클래스 선언.", "syntax": "MODIFIERS class NAME extends PARENT implements IFACE {\n    FIELDS\n    CONSTRUCTORS\n    METHODS\n}", "examples": ["public class Counter {\n    private int n;\n    public void inc() { n++; }\n}"], "related": ["java.keyword.class", "java.keyword.extends", "javascript.grammar.class-declaration", "python.grammar.class-definition"], "concepts": ["concept.class"], "tree": {"node": "CLASS_DECLARATION", "children": [{"node": "MODIFIER", "text": "public"}, {"node": "KEYWORD", "text": "class"}, {"node": "IDENTIFIER", "text": "Counter"}, {"node": "CLASS_BODY", "children": [{"node": "FIELD_DECLARATION", "text": "private int n;"}, {"node": "METHOD_DECLARATION", "text": "public void inc() { n++; }"}]}]}},
    {"id": "java.grammar.method-declaration", "symbol": "int f() {}", "name": "Method Declaration", "aliases": ["메서드 선언", "메서드 정의", "함수 정의"], "category": "declaration", "description": "수정자, 반환 타입, 이름, 매개변수 목록, 본문 블록으로 이루어진 메서드 선언. 자바에는 클래스 밖의 독립 함수가 없습니다.", "syntax": "MODIFIERS RETURN_TYPE NAME(PARAMS) {\n    BODY\n}", "examples": ["public static int add(int a, int b) {\n    return a + b;\n}"], "related": ["java.keyword.return", "java.keyword.void", "c.grammar.function-definition", "python.grammar.function-definition"], "concepts": ["concept.function"], "tree": {"node": "METHOD_DECLARATION", "children": [{"node": "MODIFIER", "text": "public static"}, {"node": "TYPE", "text": "int"}, {"node": "IDENTIFIER", "text": "add"}, {"node": "FORMAL_PARAMETERS", "text": "(int a, int b)"}, {"node": "BLOCK", "children": [{"node": "RETURN_STATEMENT", "children": [{"node": "KEYWORD", "text": "return"}, {"node": "EXPRESSION", "text": "a + b"}]}]}]}},
    {"id": "java.grammar.enhanced-for", "symbol": "for (x : xs)", "name": "Enhanced For Statement", "aliases": ["향상된 for 문", "for each", "컬렉션 순회"], "category": "statement", "description": "배열이나 Iterable의 요소를 하나씩 꺼내 순회하는 for 문. 인덱스가 필요 없을 때 쓰는 기본 순회 방법입니다.", "syntax": "for (TYPE ITEM : ITERABLE) {\n    BODY\n}", "examples": ["int[] nums = {1, 2, 3};\nint sum = 0;\nfor (int n : nums) {\n    sum += n;\n}"], "related": ["java.keyword.for", "python.grammar.for-loop"], "concepts": ["concept.loop", "concept.collection"], "tree": {"node": "ENHANCED_FOR_STATEMENT", "children": [{"node": "KEYWORD", "text": "for"}, {"node": "VARIABLE", "text": "int n"}, {"node": "ITERABLE", "text": "nums"}, {"node": "BLOCK", "text": "{ sum += n; }"}]}},
    {"id": "java.grammar.try-catch", "symbol": "try {} catch {}", "name": "Try Statement", "aliases": ["try catch 문법", "예외 처리 문법"], "category": "statement", "description": "try 블록의 예외를 타입별 catch 블록에서 처리하는 문장. finally 블록은 선택이며 항상 실행됩니다.", "syntax": "try {\n    BODY\n} catch (TYPE e) {\n    HANDLER\n} finally {\n    CLEANUP\n}", "examples": ["try {\n    int n = Integer.parseInt(\"x\");\n} catch (NumberFormatException e) {\n    System.out.println(e.getMessage());\n} finally {\n    System.out.println(\"끝\");\n}"], "related": ["java.keyword.try", "javascript.grammar.try-catch", "python.grammar.try-except"], "concepts": ["concept.error-handling"], "tree": {"node": "TRY_STATEMENT", "children": [{"node": "KEYWORD", "text": "try"}, {"node": "BLOCK", "text": "{ Integer.parseInt(\"x\"); }"}, {"node": "CATCH_CLAUSE", "children": [{"node": "KEYWORD", "text": "catch"}, {"node": "PARAMETER", "text": "NumberFormatException e"}, {"node": "BLOCK", "text": "{ ... }"}]}, {"node": "FINALLY_CLAUSE", "children": [{"node": "KEYWORD", "text": "finally"}, {"node": "BLOCK", "text": "{ ... }"}]}]}},
    {"id": "java.grammar.interface-declaration", "symbol": "interface {}", "name": "Interface Declaration", "aliases": ["인터페이스 선언 문법", "인터페이스 정의"], "category": "declaration", "description": "interface, 이름, 메서드 선언(본문 없음 또는 default/static 본문)으로 이루어진 선언. 클래스가 implements로 구현합니다.", "syntax": "interface NAME {\n    RETURN_TYPE METHOD(PARAMS);\n}", "examples": ["interface Greeter {\n    String greet(String name);\n}"], "related": ["java.keyword.interface", "java.keyword.implements"], "concepts": ["concept.class", "concept.interface"], "tree": {"node": "INTERFACE_DECLARATION", "children": [{"node": "KEYWORD", "text": "interface"}, {"node": "IDENTIFIER", "text": "Greeter"}, {"node": "INTERFACE_BODY", "children": [{"node": "METHOD_SIGNATURE", "text": "String greet(String name);"}]}]}}
  ]
}
