{
  "schemaVersion": "1.0.0", "language": "sql", "type": "function", "entryVersion": "1.0.0",
  "entries": [
    {"id":"sql.function.count","symbol":"COUNT()","name":"COUNT","aliases":["개수","행 개수","카운트"],"category":"aggregate","description":"행 개수를 셉니다. COUNT(*)는 모든 행, COUNT(열)은 그 열이 NULL이 아닌 행만 셉니다.","syntax":"COUNT(*)   COUNT(COL)   COUNT(DISTINCT COL)","examples":["SELECT COUNT(*) FROM users;","SELECT COUNT(DISTINCT city) FROM users;"],"related":["sql.function.sum","sql.keyword.group-by","sql.keyword.distinct"],"concepts":["concept.aggregation"]},
    {"id":"sql.function.sum","symbol":"SUM()","name":"SUM","aliases":["합계","총합","섬"],"category":"aggregate","description":"숫자 열의 합계를 구합니다. NULL은 무시하고, 행이 하나도 없으면 0이 아니라 NULL입니다.","syntax":"SUM(COL)","examples":["SELECT SUM(total) FROM orders;","SELECT user_id, SUM(total) FROM orders GROUP BY user_id;"],"related":["sql.function.avg","sql.function.count","python.function.sum"],"concepts":["concept.aggregation"]},
    {"id":"sql.function.avg","symbol":"AVG()","name":"AVG","aliases":["평균","애버리지"],"category":"aggregate","description":"숫자 열의 평균을 구합니다. NULL은 무시하므로 분모에 포함되지 않습니다.","syntax":"AVG(COL)","examples":["SELECT AVG(age) FROM users;"],"related":["sql.function.sum","sql.function.count","sql.function.round"],"concepts":["concept.aggregation"]},
    {"id":"sql.function.min","symbol":"MIN()","name":"MIN","aliases":["최솟값","가장 작은 값"],"category":"aggregate","description":"열의 최솟값을 구합니다. 숫자뿐 아니라 날짜, 문자열에도 쓸 수 있습니다.","syntax":"MIN(COL)","examples":["SELECT MIN(age) FROM users;"],"related":["sql.function.max"],"concepts":["concept.aggregation"]},
    {"id":"sql.function.max","symbol":"MAX()","name":"MAX","aliases":["최댓값","가장 큰 값"],"category":"aggregate","description":"열의 최댓값을 구합니다. 가장 최근 날짜를 찾을 때도 씁니다.","syntax":"MAX(COL)","examples":["SELECT MAX(total) FROM orders;","SELECT city, MAX(age) FROM users GROUP BY city;"],"related":["sql.function.min","python.function.max","javascript.function.math-max"],"concepts":["concept.aggregation"]},
    {"id":"sql.function.coalesce","symbol":"COALESCE()","name":"COALESCE","aliases":["널 대체","기본값","첫 번째 non-null"],"category":"scalar","description":"인자 중 처음으로 NULL이 아닌 값을 반환합니다. NULL을 기본값으로 바꿀 때 씁니다. 표준 SQL이라 대부분의 DB에서 같게 동작합니다.","syntax":"COALESCE(A, B, ...)","examples":["SELECT name, COALESCE(email, '없음') FROM users;"],"related":["sql.keyword.is-null","javascript.operator.nullish-coalescing"],"concepts":["concept.null-value"]},
    {"id":"sql.function.upper","symbol":"UPPER()","name":"UPPER","aliases":["대문자","대문자로 변환"],"category":"scalar","description":"문자열을 대문자로 바꿉니다. 반대는 LOWER입니다. 대소문자 무시 비교에 쓰입니다.","syntax":"UPPER(TEXT)","examples":["SELECT UPPER(name) FROM users;"],"related":["sql.function.lower","sql.keyword.like"],"concepts":["concept.string"]},
    {"id":"sql.function.lower","symbol":"LOWER()","name":"LOWER","aliases":["소문자","소문자로 변환"],"category":"scalar","description":"문자열을 소문자로 바꿉니다.","syntax":"LOWER(TEXT)","examples":["SELECT LOWER(city) FROM users;"],"related":["sql.function.upper"],"concepts":["concept.string"]},
    {"id":"sql.function.length","symbol":"LENGTH()","name":"LENGTH","aliases":["문자열 길이","길이"],"category":"scalar","description":"문자열의 길이를 반환합니다. SQLite·PostgreSQL은 문자 수지만 MySQL의 LENGTH는 바이트 수라서 문자 수는 CHAR_LENGTH를 씁니다.","syntax":"LENGTH(TEXT)","examples":["SELECT name, LENGTH(name) FROM users;"],"related":["sql.function.upper","javascript.function.string-trim"],"concepts":["concept.string"]},
    {"id":"sql.function.round","symbol":"ROUND()","name":"ROUND","aliases":["반올림","소수점 자리"],"category":"scalar","description":"숫자를 지정한 소수 자릿수로 반올림합니다. 자릿수를 생략하면 정수로 반올림합니다.","syntax":"ROUND(NUMBER, DIGITS)","examples":["SELECT ROUND(AVG(total), 1) FROM orders;"],"related":["sql.function.avg","python.function.round"],"concepts":[]},
    {"id":"sql.function.abs","symbol":"ABS()","name":"ABS","aliases":["절댓값"],"category":"scalar","description":"숫자의 절댓값을 반환합니다.","syntax":"ABS(NUMBER)","examples":["SELECT ABS(-5);"],"related":["sql.function.round","python.function.abs"],"concepts":[]},
    {"id":"sql.function.replace","symbol":"REPLACE()","name":"REPLACE","aliases":["문자열 치환","바꾸기"],"category":"scalar","description":"문자열에서 특정 부분을 모두 다른 문자열로 바꿉니다. 대소문자를 구분합니다.","syntax":"REPLACE(TEXT, FROM, TO)","examples":["SELECT REPLACE('a-b-c', '-', '+');"],"related":["javascript.function.string-replaceall"],"concepts":["concept.string"]}
  ]
}
