{
  "schemaVersion": "1.0.0", "language": "css", "type": "at-rule", "entryVersion": "1.0.0",
  "entries": [
    {"id":"css.at-rule.media","symbol":"@media","name":"@media","aliases":["미디어 쿼리","반응형","media query"],"category":"conditional","description":"화면 너비·색상 모드 같은 조건이 맞을 때만 CSS 규칙을 적용합니다. 반응형 디자인의 핵심입니다.","syntax":"@media (CONDITION) { ... }","examples":["@media (max-width: 720px) { .sidebar { display: none; } }","@media (prefers-reduced-motion: reduce) { * { animation: none; } }"],"related":["css.function.clamp"],"concepts":["concept.conditional"]},
    {"id":"css.at-rule.keyframes","symbol":"@keyframes","name":"@keyframes","aliases":["키프레임","애니메이션 정의"],"category":"animation","description":"애니메이션의 단계별 스타일을 정의합니다. animation 속성에서 이름으로 사용합니다.","syntax":"@keyframes NAME { from { ... } to { ... } }","examples":["@keyframes fade { from { opacity: 0; } to { opacity: 1; } }"],"related":["css.property.transition","css.property.opacity"],"concepts":[]},
    {"id":"css.at-rule.import","symbol":"@import","name":"@import","aliases":["임포트","css 가져오기"],"category":"module","description":"다른 CSS 파일을 불러옵니다. 파일 맨 위에 써야 하며 성능상 link 태그를 더 권장합니다.","syntax":"@import url(\"FILE\");","examples":["@import url(\"base.css\");"],"related":["html.tag.link"],"concepts":["concept.module-import"]},
    {"id":"css.at-rule.font-face","symbol":"@font-face","name":"@font-face","aliases":["웹 폰트","폰트 등록","커스텀 폰트"],"category":"typography","description":"웹 폰트 파일을 이름에 연결해 사용할 수 있게 등록합니다.","syntax":"@font-face { font-family: NAME; src: url(FILE); }","examples":["@font-face { font-family: \"Brand\"; src: url(brand.woff2) format(\"woff2\"); font-display: swap; }"],"related":["css.property.font-size"],"concepts":[]},
    {"id":"css.at-rule.supports","symbol":"@supports","name":"@supports","aliases":["기능 감지","지원 여부 쿼리","feature query"],"category":"conditional","description":"브라우저가 특정 CSS 기능을 지원할 때만 안의 규칙을 적용합니다.","syntax":"@supports (PROPERTY: VALUE) { ... }","examples":["@supports (display: grid) { .layout { display: grid; } }"],"related":["css.at-rule.media"],"concepts":["concept.conditional"]},
    {"id":"css.at-rule.layer","symbol":"@layer","name":"@layer","aliases":["캐스케이드 레이어","레이어 순서"],"category":"organization","description":"캐스케이드 레이어를 선언해 스타일의 우선순위를 선택자 특이성과 상관없이 레이어 순서로 정합니다.","syntax":"@layer NAME { ... }","examples":["@layer reset, base, components;\n@layer base { body { margin: 0; } }"],"related":["css.at-rule.import"],"concepts":[]},
    {"id":"css.at-rule.container","symbol":"@container","name":"@container","aliases":["컨테이너 쿼리","container query"],"category":"conditional","description":"뷰포트가 아니라 조상 컨테이너의 크기에 따라 스타일을 적용합니다. 컨테이너에는 container-type이 필요합니다.","syntax":"@container (CONDITION) { ... }","examples":[".card-wrap { container-type: inline-size; }\n@container (min-width: 400px) { .card { display: flex; } }"],"related":["css.at-rule.media"],"concepts":["concept.conditional"]},
    {"id":"css.at-rule.property","symbol":"@property","name":"@property","aliases":["커스텀 속성 등록","타입 있는 변수"],"category":"declaration","description":"CSS 변수(--이름)에 타입, 초기값, 상속 여부를 등록해 애니메이션이 가능하게 합니다.","syntax":"@property --NAME { syntax: \"TYPE\"; inherits: false; initial-value: VALUE; }","examples":["@property --angle { syntax: \"<angle>\"; inherits: false; initial-value: 0deg; }"],"related":["css.function.var"],"concepts":["concept.variable"]}
  ]
}
