{
  "schemaVersion": "1.0.0", "language": "css", "type": "property", "entryVersion": "1.0.0",
  "entries": [
    {"id":"css.property.display","symbol":"display","name":"display","aliases":["디스플레이","표시 방식","레이아웃 방식"],"category":"layout","description":"요소의 표시 방식을 정합니다. block, inline, flex, grid, none 등이 있습니다.","syntax":"display: VALUE;","examples":["display: flex;","display: none;"],"related":["css.property.flex","css.property.grid"],"concepts":[]},
    {"id":"css.property.position","symbol":"position","name":"position","aliases":["포지션","위치 지정"],"category":"layout","description":"요소를 배치하는 기준을 정합니다. static, relative, absolute, fixed, sticky가 있고 top/right/bottom/left와 함께 씁니다.","syntax":"position: VALUE;","examples":["position: absolute; top: 0; right: 0;","position: sticky; top: 0;"],"related":["css.property.z-index"],"concepts":[]},
    {"id":"css.property.z-index","symbol":"z-index","name":"z-index","aliases":["z 인덱스","겹침 순서","쌓임 순서"],"category":"layout","description":"겹친 요소의 앞뒤 순서를 정합니다. 값이 클수록 앞에 보이며 position이 static이 아닌 요소 등에 적용됩니다.","syntax":"z-index: INTEGER;","examples":["z-index: 10;"],"related":["css.property.position"],"concepts":[]},
    {"id":"css.property.overflow","symbol":"overflow","name":"overflow","aliases":["넘침","스크롤","오버플로"],"category":"layout","description":"내용이 박스를 넘칠 때 처리 방식을 정합니다. visible, hidden, scroll, auto.","syntax":"overflow: VALUE;","examples":["overflow: auto;","overflow: hidden;"],"related":["css.property.display"],"concepts":[]},
    {"id":"css.property.margin","symbol":"margin","name":"margin","aliases":["마진","바깥 여백","외부 여백"],"category":"box-model","description":"요소 바깥쪽 여백. 값 1~4개로 위/오른쪽/아래/왼쪽을 지정합니다.","syntax":"margin: TOP RIGHT BOTTOM LEFT;","examples":["margin: 0 auto;","margin: 8px 16px;"],"related":["css.property.padding","css.property.border"],"concepts":[]},
    {"id":"css.property.padding","symbol":"padding","name":"padding","aliases":["패딩","안쪽 여백","내부 여백"],"category":"box-model","description":"테두리와 내용 사이의 안쪽 여백.","syntax":"padding: TOP RIGHT BOTTOM LEFT;","examples":["padding: 12px 16px;"],"related":["css.property.margin","css.property.box-sizing"],"concepts":[]},
    {"id":"css.property.border","symbol":"border","name":"border","aliases":["보더","테두리","경계선"],"category":"box-model","description":"테두리의 두께, 스타일, 색을 한 번에 지정하는 단축 속성.","syntax":"border: WIDTH STYLE COLOR;","examples":["border: 1px solid #ccc;","border-radius: 8px;"],"related":["css.property.margin","css.property.padding"],"concepts":[]},
    {"id":"css.property.width","symbol":"width","name":"width","aliases":["너비","가로 크기","폭"],"category":"box-model","description":"요소의 너비. px, %, rem, vw 등의 단위를 쓸 수 있으며 max-width, min-width로 범위를 제한합니다.","syntax":"width: LENGTH;","examples":["width: 100%;","max-width: 960px;"],"related":["css.property.box-sizing"],"concepts":[]},
    {"id":"css.property.box-sizing","symbol":"box-sizing","name":"box-sizing","aliases":["박스 사이징","크기 계산 방식"],"category":"box-model","description":"width/height에 padding과 border를 포함할지 정합니다. border-box는 포함, content-box는 제외합니다.","syntax":"box-sizing: border-box;","examples":["*, *::before, *::after { box-sizing: border-box; }"],"related":["css.property.padding","css.property.width","css.selector.universal"],"concepts":[]},
    {"id":"css.property.color","symbol":"color","name":"color","aliases":["글자색","텍스트 색","색상"],"category":"typography","description":"텍스트의 색을 지정합니다.","syntax":"color: COLOR;","examples":["color: #0a5cff;","color: rgb(255 138 0);"],"related":["css.property.background"],"concepts":[]},
    {"id":"css.property.font-size","symbol":"font-size","name":"font-size","aliases":["글자 크기","폰트 크기"],"category":"typography","description":"글자 크기를 지정합니다. rem, em, px 등의 단위를 씁니다.","syntax":"font-size: LENGTH;","examples":["font-size: 1rem;","font-size: clamp(14px, 2vw, 18px);"],"related":["css.function.clamp"],"concepts":[]},
    {"id":"css.property.text-align","symbol":"text-align","name":"text-align","aliases":["텍스트 정렬","글자 정렬"],"category":"typography","description":"텍스트의 가로 정렬. left, center, right, justify.","syntax":"text-align: VALUE;","examples":["text-align: center;"],"related":["css.property.justify-content"],"concepts":[]},
    {"id":"css.property.background","symbol":"background","name":"background","aliases":["배경","배경색","배경 이미지"],"category":"visual","description":"배경색, 이미지, 위치, 반복 등을 한 번에 지정하는 단축 속성.","syntax":"background: COLOR IMAGE POSITION / SIZE REPEAT;","examples":["background: #f6f8fc;","background: url(bg.png) center / cover no-repeat;"],"related":["css.property.color"],"concepts":[]},
    {"id":"css.property.opacity","symbol":"opacity","name":"opacity","aliases":["투명도","불투명도"],"category":"visual","description":"요소 전체의 불투명도. 0(완전 투명)부터 1(불투명)까지.","syntax":"opacity: NUMBER;","examples":["opacity: 0.6;"],"related":["css.property.transition"],"concepts":[]},
    {"id":"css.property.flex","symbol":"flex","name":"flex","aliases":["플렉스","플렉스박스","flexbox"],"category":"flexbox","description":"flex 컨테이너 안에서 항목의 늘어남·줄어듦·기본 크기를 정하는 단축 속성. 컨테이너에는 display: flex를 지정합니다.","syntax":"flex: GROW SHRINK BASIS;","examples":["flex: 1;","flex: 0 0 200px;"],"related":["css.property.display","css.property.justify-content","css.property.align-items","css.property.gap"],"concepts":[]},
    {"id":"css.property.justify-content","symbol":"justify-content","name":"justify-content","aliases":["주축 정렬","가로 정렬"],"category":"flexbox","description":"flex·grid 컨테이너에서 주축 방향 정렬을 정합니다. flex-start, center, space-between 등.","syntax":"justify-content: VALUE;","examples":["justify-content: space-between;"],"related":["css.property.align-items","css.property.flex"],"concepts":[]},
    {"id":"css.property.align-items","symbol":"align-items","name":"align-items","aliases":["교차축 정렬","세로 정렬"],"category":"flexbox","description":"flex·grid 컨테이너에서 교차축 방향 정렬을 정합니다. stretch, center, flex-start 등.","syntax":"align-items: VALUE;","examples":["align-items: center;"],"related":["css.property.justify-content","css.property.flex"],"concepts":[]},
    {"id":"css.property.gap","symbol":"gap","name":"gap","aliases":["간격","갭","항목 사이 간격"],"category":"flexbox","description":"flex·grid 항목 사이의 간격.","syntax":"gap: ROW COLUMN;","examples":["gap: 16px;"],"related":["css.property.flex","css.property.grid"],"concepts":[]},
    {"id":"css.property.grid","symbol":"grid","name":"grid","aliases":["그리드","격자 레이아웃"],"category":"grid","description":"행과 열로 이루어진 2차원 레이아웃. display: grid와 grid-template-columns 등을 함께 사용합니다.","syntax":"display: grid; grid-template-columns: TRACKS;","examples":["display: grid; grid-template-columns: repeat(3, 1fr);"],"related":["css.property.display","css.property.gap"],"concepts":[]},
    {"id":"css.property.transition","symbol":"transition","name":"transition","aliases":["트랜지션","전환 효과","애니메이션 전환"],"category":"animation","description":"속성 값이 바뀔 때 부드럽게 변하도록 시간과 가속 곡선을 지정합니다.","syntax":"transition: PROPERTY DURATION EASING;","examples":["transition: background-color 0.2s ease;"],"related":["css.property.transform","css.selector.hover","css.at-rule.keyframes"],"concepts":[]},
    {"id":"css.property.transform","symbol":"transform","name":"transform","aliases":["트랜스폼","변형","이동 회전 확대"],"category":"animation","description":"요소를 이동(translate), 회전(rotate), 확대·축소(scale)합니다.","syntax":"transform: FUNCTION(VALUE);","examples":["transform: translateY(-4px) scale(1.02);"],"related":["css.property.transition"],"concepts":[]},
    {"id":"css.property.height","symbol":"height","name":"height","aliases":["높이","세로 크기"],"category":"box-model","description":"요소의 높이. min-height, max-height로 범위를 제한합니다. auto이면 내용에 맞춰집니다.","syntax":"height: LENGTH;","examples":["height: 100vh;","min-height: 200px;"],"related":["css.property.width","css.property.box-sizing"],"concepts":[]},
    {"id":"css.property.max-width","symbol":"max-width","name":"max-width","aliases":["최대 너비","최대 가로 크기"],"category":"box-model","description":"요소가 이보다 넓어지지 않게 제한합니다. 반응형 레이아웃에서 width: 100%와 함께 많이 씁니다.","syntax":"max-width: LENGTH;","examples":["max-width: 960px; margin: 0 auto;"],"related":["css.property.width","css.property.margin"],"concepts":[]},
    {"id":"css.property.aspect-ratio","symbol":"aspect-ratio","name":"aspect-ratio","aliases":["가로세로 비율","종횡비"],"category":"box-model","description":"요소의 선호하는 가로:세로 비율을 지정합니다. 너비나 높이 중 하나만 정해도 나머지가 비율에 맞춰집니다.","syntax":"aspect-ratio: WIDTH / HEIGHT;","examples":["aspect-ratio: 16 / 9;"],"related":["css.property.width","css.property.height","css.property.object-fit"],"concepts":[]},
    {"id":"css.property.border-radius","symbol":"border-radius","name":"border-radius","aliases":["둥근 모서리","라운드","모서리 반경"],"category":"box-model","description":"모서리를 둥글게 만듭니다. 50%를 주면 정사각형이 원이 됩니다.","syntax":"border-radius: LENGTH;","examples":["border-radius: 8px;","border-radius: 50%;"],"related":["css.property.border"],"concepts":[]},
    {"id":"css.property.box-shadow","symbol":"box-shadow","name":"box-shadow","aliases":["그림자","박스 그림자","drop shadow"],"category":"visual","description":"요소 상자에 그림자를 드리웁니다. x, y 오프셋, 흐림 반경, 퍼짐, 색 순서로 씁니다.","syntax":"box-shadow: X Y BLUR SPREAD COLOR;","examples":["box-shadow: 0 4px 12px rgb(0 0 0 / 15%);"],"related":["css.property.border-radius","css.function.rgb"],"concepts":[]},
    {"id":"css.property.filter","symbol":"filter","name":"filter","aliases":["필터","블러","흐림 효과"],"category":"visual","description":"요소에 blur(), brightness(), grayscale() 같은 그래픽 효과를 적용합니다.","syntax":"filter: FUNCTION(VALUE);","examples":["filter: blur(4px) brightness(0.9);"],"related":["css.property.opacity"],"concepts":[]},
    {"id":"css.property.object-fit","symbol":"object-fit","name":"object-fit","aliases":["이미지 맞춤","오브젝트 핏","cover contain"],"category":"visual","description":"img, video가 자기 상자에 어떻게 맞춰질지 정합니다. cover는 꽉 채우며 잘리고, contain은 전체가 보이도록 줄입니다.","syntax":"object-fit: VALUE;","examples":["object-fit: cover;"],"related":["css.property.aspect-ratio","css.property.width"],"concepts":[]},
    {"id":"css.property.visibility","symbol":"visibility","name":"visibility","aliases":["보임 여부","가시성"],"category":"visual","description":"요소를 숨기되 자리는 유지합니다(hidden). display: none은 자리까지 없앱니다.","syntax":"visibility: VALUE;","examples":["visibility: hidden;"],"related":["css.property.display","css.property.opacity"],"concepts":[]},
    {"id":"css.property.cursor","symbol":"cursor","name":"cursor","aliases":["커서","마우스 포인터 모양"],"category":"visual","description":"마우스를 올렸을 때 포인터 모양을 정합니다. pointer, text, not-allowed 등.","syntax":"cursor: VALUE;","examples":["cursor: pointer;"],"related":["css.selector.hover","css.property.pointer-events"],"concepts":[]},
    {"id":"css.property.pointer-events","symbol":"pointer-events","name":"pointer-events","aliases":["포인터 이벤트","클릭 무시"],"category":"visual","description":"요소가 마우스·터치 이벤트의 대상이 될지 정합니다. none이면 클릭이 아래 요소로 통과합니다.","syntax":"pointer-events: VALUE;","examples":["pointer-events: none;"],"related":["css.property.cursor"],"concepts":[]},
    {"id":"css.property.outline","symbol":"outline","name":"outline","aliases":["아웃라인","포커스 링","외곽선"],"category":"visual","description":"요소 바깥에 그려지는 윤곽선으로 레이아웃 공간을 차지하지 않습니다. 키보드 포커스 표시에 쓰이므로 없애면 접근성이 나빠집니다.","syntax":"outline: WIDTH STYLE COLOR;","examples":["outline: 2px solid #0a4fe0; outline-offset: 2px;"],"related":["css.property.border","css.selector.focus"],"concepts":[]},
    {"id":"css.property.font-weight","symbol":"font-weight","name":"font-weight","aliases":["글자 굵기","폰트 굵기","bold"],"category":"typography","description":"글자의 굵기를 100~900 숫자 또는 normal, bold로 지정합니다.","syntax":"font-weight: VALUE;","examples":["font-weight: 700;"],"related":["css.property.font-size","css.property.font-family"],"concepts":[]},
    {"id":"css.property.font-family","symbol":"font-family","name":"font-family","aliases":["글꼴","폰트","폰트 패밀리"],"category":"typography","description":"사용할 글꼴 목록. 앞에서부터 사용 가능한 첫 글꼴이 쓰이므로 마지막에 serif, sans-serif 같은 일반 글꼴을 둡니다.","syntax":"font-family: NAME, NAME, GENERIC;","examples":["font-family: \"Noto Sans KR\", system-ui, sans-serif;"],"related":["css.at-rule.font-face","css.property.font-weight"],"concepts":[]},
    {"id":"css.property.line-height","symbol":"line-height","name":"line-height","aliases":["줄 높이","행간"],"category":"typography","description":"줄의 높이(행간)를 정합니다. 단위 없는 숫자는 글자 크기의 배수입니다.","syntax":"line-height: NUMBER | LENGTH;","examples":["line-height: 1.6;"],"related":["css.property.font-size"],"concepts":[]},
    {"id":"css.property.letter-spacing","symbol":"letter-spacing","name":"letter-spacing","aliases":["자간","글자 간격"],"category":"typography","description":"글자 사이의 간격을 조절합니다.","syntax":"letter-spacing: LENGTH;","examples":["letter-spacing: 0.04em;"],"related":["css.property.font-size","css.property.line-height"],"concepts":[]},
    {"id":"css.property.text-decoration","symbol":"text-decoration","name":"text-decoration","aliases":["밑줄","취소선","텍스트 장식"],"category":"typography","description":"밑줄, 윗줄, 취소선 같은 텍스트 장식을 지정합니다. 링크 밑줄을 없앨 때 none을 씁니다.","syntax":"text-decoration: LINE STYLE COLOR;","examples":["text-decoration: none;","text-decoration: underline wavy red;"],"related":["css.property.color"],"concepts":[]},
    {"id":"css.property.white-space","symbol":"white-space","name":"white-space","aliases":["공백 처리","줄바꿈 제어","nowrap"],"category":"typography","description":"공백과 줄바꿈을 어떻게 처리할지 정합니다. nowrap은 줄바꿈 금지, pre는 입력한 그대로 유지합니다.","syntax":"white-space: VALUE;","examples":["white-space: nowrap;"],"related":["css.property.text-overflow","css.property.overflow"],"concepts":[]},
    {"id":"css.property.text-overflow","symbol":"text-overflow","name":"text-overflow","aliases":["말줄임","생략 부호","ellipsis"],"category":"typography","description":"넘친 텍스트를 잘라 낼 때 ...로 표시합니다. overflow: hidden과 white-space: nowrap이 함께 필요합니다.","syntax":"text-overflow: ellipsis;","examples":["overflow: hidden; white-space: nowrap; text-overflow: ellipsis;"],"related":["css.property.overflow","css.property.white-space"],"concepts":[]},
    {"id":"css.property.flex-direction","symbol":"flex-direction","name":"flex-direction","aliases":["플렉스 방향","주축 방향"],"category":"flexbox","description":"flex 컨테이너의 주축 방향을 정합니다. row(가로), column(세로), 그리고 -reverse 값들.","syntax":"flex-direction: VALUE;","examples":["display: flex; flex-direction: column;"],"related":["css.property.flex","css.property.flex-wrap","css.property.justify-content"],"concepts":[]},
    {"id":"css.property.flex-wrap","symbol":"flex-wrap","name":"flex-wrap","aliases":["플렉스 줄바꿈","줄 넘김"],"category":"flexbox","description":"flex 항목이 한 줄에 다 안 들어갈 때 다음 줄로 넘길지 정합니다.","syntax":"flex-wrap: VALUE;","examples":["flex-wrap: wrap;"],"related":["css.property.flex-direction","css.property.gap"],"concepts":[]},
    {"id":"css.property.grid-template-columns","symbol":"grid-template-columns","name":"grid-template-columns","aliases":["그리드 열","열 정의"],"category":"grid","description":"그리드의 열 개수와 너비를 정의합니다. fr 단위와 repeat()를 자주 씁니다.","syntax":"grid-template-columns: TRACK-LIST;","examples":["grid-template-columns: repeat(3, 1fr);","grid-template-columns: 240px 1fr;"],"related":["css.property.grid","css.function.repeat","css.function.minmax"],"concepts":[]},
    {"id":"css.property.place-items","symbol":"place-items","name":"place-items","aliases":["중앙 정렬","가운데 정렬"],"category":"grid","description":"align-items와 justify-items를 한 번에 지정합니다. grid에서 place-items: center로 가운데 정렬합니다.","syntax":"place-items: ALIGN JUSTIFY;","examples":["display: grid; place-items: center;"],"related":["css.property.align-items","css.property.grid"],"concepts":[]},
    {"id":"css.property.animation","symbol":"animation","name":"animation","aliases":["애니메이션","키프레임 실행"],"category":"animation","description":"@keyframes로 정의한 애니메이션을 이름, 시간, 가속, 반복 횟수와 함께 적용하는 단축 속성.","syntax":"animation: NAME DURATION EASING ITERATIONS;","examples":["animation: fade 0.3s ease-out 1;"],"related":["css.at-rule.keyframes","css.property.transition"],"concepts":[]},
    {"id":"css.property.content","symbol":"content","name":"content","aliases":["콘텐츠","가상 요소 내용"],"category":"visual","description":"::before, ::after 가상 요소에 들어갈 내용을 지정합니다. 빈 문자열(\"\")도 요소를 만들기 위해 씁니다.","syntax":"content: STRING;","examples":["content: \"→\";"],"related":["css.selector.before","css.selector.after"],"concepts":[]},
    {"id":"css.property.list-style","symbol":"list-style","name":"list-style","aliases":["목록 스타일","불릿 제거"],"category":"visual","description":"목록 항목 앞의 불릿/번호 모양을 정하는 단축 속성. none이면 표시를 없앱니다.","syntax":"list-style: TYPE POSITION IMAGE;","examples":["list-style: none;"],"related":["html.tag.ul","html.tag.ol"],"concepts":[]},
    {"id":"css.property.user-select","symbol":"user-select","name":"user-select","aliases":["텍스트 선택","드래그 방지"],"category":"visual","description":"사용자가 텍스트를 선택할 수 있는지 정합니다. none이면 선택되지 않습니다.","syntax":"user-select: VALUE;","examples":["user-select: none;"],"related":["css.property.pointer-events"],"concepts":[]},
    {"id":"css.property.scroll-behavior","symbol":"scroll-behavior","name":"scroll-behavior","aliases":["부드러운 스크롤","스무스 스크롤"],"category":"animation","description":"앵커 이동이나 scrollTo()의 스크롤을 부드럽게(smooth) 할지 정합니다.","syntax":"scroll-behavior: smooth;","examples":["html { scroll-behavior: smooth; }"],"related":["css.property.overflow"],"concepts":[]}
  ]
}
