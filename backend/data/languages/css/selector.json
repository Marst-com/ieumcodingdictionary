{
  "schemaVersion": "1.0.0", "language": "css", "type": "selector", "entryVersion": "1.0.0",
  "entries": [
    {"id":"css.selector.class","symbol":".name","name":"Class Selector","aliases":["클래스 선택자","점 선택자"],"category":"basic","description":"class 속성이 일치하는 모든 요소를 선택합니다.","syntax":".CLASS { ... }","examples":[".card { padding: 16px; }"],"related":["html.attribute.class","css.selector.id"],"concepts":[]},
    {"id":"css.selector.id","symbol":"#name","name":"ID Selector","aliases":["아이디 선택자","샵 선택자"],"category":"basic","description":"id 속성이 일치하는 요소 하나를 선택합니다.","syntax":"#ID { ... }","examples":["#app { min-height: 100vh; }"],"related":["html.attribute.id","css.selector.class"],"concepts":[]},
    {"id":"css.selector.universal","symbol":"*","name":"Universal Selector","aliases":["전체 선택자","별 선택자"],"category":"basic","description":"문서의 모든 요소를 선택합니다.","syntax":"* { ... }","examples":["* { margin: 0; }"],"related":["css.property.box-sizing"],"concepts":[]},
    {"id":"css.selector.descendant","symbol":"A B","name":"Descendant Combinator","aliases":["후손 선택자","자손 선택자","공백 선택자"],"category":"combinator","description":"A 안에 있는 모든 B를 (깊이와 상관없이) 선택합니다.","syntax":"A B { ... }","examples":["nav a { color: inherit; }"],"related":["css.selector.child"],"concepts":[]},
    {"id":"css.selector.child","symbol":"A > B","name":"Child Combinator","aliases":["자식 선택자","직계 자식"],"category":"combinator","description":"A의 바로 아래 자식인 B만 선택합니다.","syntax":"A > B { ... }","examples":["ul > li { list-style: none; }"],"related":["css.selector.descendant"],"concepts":[]},
    {"id":"css.selector.hover","symbol":":hover","name":":hover","aliases":["호버","마우스 오버","의사 클래스"],"category":"pseudo-class","description":"마우스 포인터가 올라가 있는 요소를 선택하는 의사 클래스.","syntax":"SELECTOR:hover { ... }","examples":["button:hover { background: #0a5cff; }"],"related":["css.property.transition"],"concepts":[]},
    {"id":"css.selector.before","symbol":"::before","name":"::before","aliases":["비포","가상 요소","의사 요소","after"],"category":"pseudo-element","description":"요소 내용 앞에 가상의 요소를 만듭니다. content 속성이 필요하며 ::after는 뒤에 만듭니다.","syntax":"SELECTOR::before { content: \"TEXT\"; }","examples":[".required::before { content: \"* \"; }"],"related":[],"concepts":[]},
    {"id":"css.selector.attribute","symbol":"[attr]","name":"Attribute Selector","aliases":["속성 선택자","대괄호 선택자"],"category":"basic","description":"특정 속성이 있거나 값이 일치하는 요소를 선택합니다.","syntax":"[ATTR=\"VALUE\"] { ... }","examples":["input[type=\"email\"] { width: 100%; }","a[target=\"_blank\"] { ... }"],"related":["html.attribute.type"],"concepts":[]},
    {"id":"css.selector.focus","symbol":":focus","name":":focus","aliases":["포커스","키보드 포커스","의사 클래스 포커스"],"category":"pseudo-class","description":"포커스를 받은 요소를 선택합니다. 키보드 접근성을 위해 :focus-visible과 함께 많이 씁니다.","syntax":"SELECTOR:focus { ... }","examples":["input:focus { border-color: #0a4fe0; }","button:focus-visible { outline: 2px solid; }"],"related":["css.property.outline","css.selector.hover"],"concepts":[]},
    {"id":"css.selector.first-child","symbol":":first-child","name":":first-child","aliases":["첫 번째 자식","마지막 자식","last-child"],"category":"pseudo-class","description":"부모의 첫 번째 자식인 요소를 선택합니다. :last-child는 마지막 자식입니다.","syntax":"SELECTOR:first-child { ... }","examples":["li:first-child { font-weight: 700; }"],"related":["css.selector.nth-child"],"concepts":[]},
    {"id":"css.selector.nth-child","symbol":":nth-child()","name":":nth-child()","aliases":["n번째 자식","짝수 홀수","even odd"],"category":"pseudo-class","description":"형제 중 n번째에 해당하는 요소를 선택합니다. 2n, odd, even, 3n+1 같은 식을 쓸 수 있습니다.","syntax":"SELECTOR:nth-child(EXPRESSION) { ... }","examples":["tr:nth-child(even) { background: #f6f8fc; }"],"related":["css.selector.first-child"],"concepts":[]},
    {"id":"css.selector.not","symbol":":not()","name":":not()","aliases":["제외 선택자","부정 선택자"],"category":"pseudo-class","description":"괄호 안 선택자에 해당하지 않는 요소를 선택합니다.","syntax":"SELECTOR:not(OTHER) { ... }","examples":["li:not(.done) { opacity: 1; }"],"related":["css.selector.is","css.selector.has"],"concepts":["concept.boolean-logic"]},
    {"id":"css.selector.is","symbol":":is()","name":":is()","aliases":["목록 선택자","묶음 선택자"],"category":"pseudo-class","description":"여러 선택자 중 하나라도 맞으면 선택합니다. 반복되는 긴 선택자를 줄일 때 씁니다.","syntax":":is(SELECTOR, SELECTOR) { ... }","examples":[":is(h1, h2, h3):hover { color: #0a4fe0; }"],"related":["css.selector.not","css.selector.has"],"concepts":["concept.boolean-logic"]},
    {"id":"css.selector.has","symbol":":has()","name":":has()","aliases":["부모 선택자","관계 선택자"],"category":"pseudo-class","description":"괄호 안 선택자에 해당하는 후손(또는 형제)을 가진 요소를 선택합니다. 흔히 \"부모 선택자\"로 불립니다.","syntax":"SELECTOR:has(RELATIVE-SELECTOR) { ... }","examples":["label:has(input:checked) { font-weight: 700; }"],"related":["css.selector.not","css.selector.is"],"concepts":[]},
    {"id":"css.selector.after","symbol":"::after","name":"::after","aliases":["애프터","뒤 가상 요소"],"category":"pseudo-element","description":"요소 내용 뒤에 가상의 요소를 만듭니다. content 속성이 필요합니다.","syntax":"SELECTOR::after { content: \"TEXT\"; }","examples":["a[target=\"_blank\"]::after { content: \" ↗\"; }"],"related":["css.selector.before","css.property.content"],"concepts":[]},
    {"id":"css.selector.adjacent","symbol":"A + B","name":"Adjacent Sibling Combinator","aliases":["인접 형제 선택자","바로 다음 형제"],"category":"combinator","description":"A 바로 뒤에 오는 형제 B 하나를 선택합니다.","syntax":"A + B { ... }","examples":["h2 + p { margin-top: 0; }"],"related":["css.selector.general-sibling","css.selector.child"],"concepts":[]},
    {"id":"css.selector.general-sibling","symbol":"A ~ B","name":"General Sibling Combinator","aliases":["일반 형제 선택자","뒤따르는 모든 형제"],"category":"combinator","description":"A 뒤에 오는 같은 부모의 모든 형제 B를 선택합니다.","syntax":"A ~ B { ... }","examples":["input:checked ~ label { color: green; }"],"related":["css.selector.adjacent"],"concepts":[]},
    {"id":"css.selector.placeholder","symbol":"::placeholder","name":"::placeholder","aliases":["플레이스홀더 스타일","안내 문구 스타일"],"category":"pseudo-element","description":"input, textarea의 placeholder 텍스트를 선택해 스타일을 지정합니다.","syntax":"::placeholder { ... }","examples":["input::placeholder { color: #8493b0; }"],"related":["html.attribute.placeholder"],"concepts":[]}
  ]
}
