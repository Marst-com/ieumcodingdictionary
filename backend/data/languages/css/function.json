{
  "schemaVersion": "1.0.0", "language": "css", "type": "function", "entryVersion": "1.0.0",
  "entries": [
    {"id":"css.function.var","symbol":"var()","name":"var()","aliases":["css 변수","커스텀 속성","custom property"],"category":"value","description":"--이름으로 선언한 CSS 변수의 값을 가져옵니다. 두 번째 인자는 대체값입니다.","syntax":"var(--NAME, FALLBACK)","examples":[":root { --brand: #0a5cff; } a { color: var(--brand); }"],"related":["css.function.calc"],"concepts":["concept.variable"]},
    {"id":"css.function.calc","symbol":"calc()","name":"calc()","aliases":["계산","calc"],"category":"value","description":"단위가 다른 값을 섞어 계산합니다. 연산자 앞뒤에는 공백이 필요합니다.","syntax":"calc(EXPRESSION)","examples":["width: calc(100% - 240px);"],"related":["css.function.var","css.function.clamp"],"concepts":[]},
    {"id":"css.function.clamp","symbol":"clamp()","name":"clamp()","aliases":["클램프","최소 최대 범위"],"category":"value","description":"값을 최솟값과 최댓값 사이로 제한합니다. 반응형 글자 크기에 자주 씁니다.","syntax":"clamp(MIN, PREFERRED, MAX)","examples":["font-size: clamp(1rem, 2vw, 1.5rem);"],"related":["css.function.calc","css.property.font-size"],"concepts":[]},
    {"id":"css.function.min","symbol":"min()","name":"min()","aliases":["최솟값 함수","둘 중 작은 값"],"category":"value","description":"여러 값 중 가장 작은 값을 선택합니다. width: min(100%, 600px)처럼 상한을 둘 때 씁니다.","syntax":"min(VALUE, VALUE, ...)","examples":["width: min(100%, 600px);"],"related":["css.function.max","css.function.clamp"],"concepts":[]},
    {"id":"css.function.max","symbol":"max()","name":"max()","aliases":["최댓값 함수","둘 중 큰 값"],"category":"value","description":"여러 값 중 가장 큰 값을 선택합니다. 하한을 둘 때 씁니다.","syntax":"max(VALUE, VALUE, ...)","examples":["font-size: max(16px, 1.2vw);"],"related":["css.function.min","css.function.clamp"],"concepts":[]},
    {"id":"css.function.rgb","symbol":"rgb()","name":"rgb()","aliases":["RGB 색","빨강 초록 파랑","투명도 색"],"category":"color","description":"빨강·초록·파랑 값으로 색을 지정합니다. 슬래시 뒤에 알파(투명도)를 줄 수 있습니다.","syntax":"rgb(R G B / ALPHA)","examples":["color: rgb(10 79 224);","background: rgb(0 0 0 / 50%);"],"related":["css.function.hsl","css.property.color"],"concepts":[]},
    {"id":"css.function.hsl","symbol":"hsl()","name":"hsl()","aliases":["HSL 색","색상 채도 명도"],"category":"color","description":"색상(0~360°), 채도, 명도로 색을 지정합니다. 같은 색 계열에서 명도만 바꿔 팔레트를 만들기 좋습니다.","syntax":"hsl(H S L / ALPHA)","examples":["color: hsl(220 90% 45%);"],"related":["css.function.rgb"],"concepts":[]},
    {"id":"css.function.linear-gradient","symbol":"linear-gradient()","name":"linear-gradient()","aliases":["그라데이션","선형 그라디언트"],"category":"image","description":"한 방향으로 색이 이어지는 이미지를 만듭니다. background-image 등에 쓰입니다.","syntax":"linear-gradient(ANGLE, COLOR STOP, COLOR STOP)","examples":["background: linear-gradient(135deg, #0a4fe0, #f97800);"],"related":["css.property.background","css.function.rgb"],"concepts":[]},
    {"id":"css.function.repeat","symbol":"repeat()","name":"repeat()","aliases":["반복 트랙","열 반복"],"category":"grid","description":"그리드 트랙 정의를 반복합니다. auto-fill, auto-fit과 minmax()를 조합하면 반응형 열을 만듭니다.","syntax":"repeat(COUNT, TRACK)","examples":["grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));"],"related":["css.property.grid-template-columns","css.function.minmax"],"concepts":[]},
    {"id":"css.function.minmax","symbol":"minmax()","name":"minmax()","aliases":["최소 최대 트랙"],"category":"grid","description":"그리드 트랙 크기가 최솟값과 최댓값 사이에서 정해지게 합니다.","syntax":"minmax(MIN, MAX)","examples":["grid-template-columns: minmax(200px, 1fr) 2fr;"],"related":["css.function.repeat","css.property.grid-template-columns"],"concepts":[]},
    {"id":"css.function.url","symbol":"url()","name":"url()","aliases":["이미지 주소","리소스 경로"],"category":"value","description":"이미지나 폰트 같은 외부 리소스의 주소를 지정합니다.","syntax":"url(\"PATH\")","examples":["background-image: url(\"bg.png\");"],"related":["css.property.background","css.at-rule.font-face"],"concepts":[]},
    {"id":"css.function.translate","symbol":"translate()","name":"translate()","aliases":["이동 변형","translateX translateY"],"category":"transform","description":"transform 안에서 요소를 x, y 방향으로 옮깁니다. 레이아웃에 영향을 주지 않아 애니메이션에 적합합니다.","syntax":"translate(X, Y)","examples":["transform: translate(-50%, -50%);"],"related":["css.property.transform"],"concepts":[]}
  ]
}
