{
  "schemaVersion": "1.0.0", "language": "html", "type": "attribute", "entryVersion": "1.0.0",
  "entries": [
    {"id":"html.attribute.id","symbol":"id","name":"id","aliases":["아이디","고유 식별자"],"category":"global","description":"문서 안에서 요소를 유일하게 식별하는 이름. CSS 선택자(#id)와 앵커 이동에 쓰입니다.","syntax":"<tag id=\"NAME\">","examples":["<div id=\"app\"></div>"],"related":["html.attribute.class","css.selector.id"],"concepts":[],"appliesTo":["*"]},
    {"id":"html.attribute.class","symbol":"class","name":"class","aliases":["클래스","클래스명"],"category":"global","description":"여러 요소가 공유할 수 있는 이름. 공백으로 구분해 여러 개를 지정하며 CSS 선택자(.class)로 스타일링합니다.","syntax":"<tag class=\"NAME1 NAME2\">","examples":["<button class=\"btn primary\">확인</button>"],"related":["html.attribute.id","css.selector.class"],"concepts":[],"appliesTo":["*"]},
    {"id":"html.attribute.style","symbol":"style","name":"style","aliases":["인라인 스타일"],"category":"global","description":"요소에 CSS 선언을 직접 지정합니다.","syntax":"<tag style=\"PROPERTY: VALUE;\">","examples":["<p style=\"color: red; font-size: 18px;\">경고</p>"],"related":["html.tag.style"],"concepts":[],"appliesTo":["*"]},
    {"id":"html.attribute.lang","symbol":"lang","name":"lang","aliases":["언어 지정"],"category":"global","description":"요소 내용의 언어를 지정합니다. 스크린 리더와 번역 기능이 사용합니다.","syntax":"<tag lang=\"CODE\">","examples":["<html lang=\"ko\">"],"related":["html.tag.html"],"concepts":[],"appliesTo":["*"]},
    {"id":"html.attribute.data","symbol":"data-*","name":"data-*","aliases":["데이터 속성","커스텀 속성","dataset"],"category":"global","description":"요소에 사용자 정의 데이터를 붙입니다. JavaScript에서는 element.dataset으로 읽습니다.","syntax":"<tag data-NAME=\"VALUE\">","examples":["<li data-id=\"42\">항목</li>"],"related":[],"concepts":[],"appliesTo":["*"]},
    {"id":"html.attribute.href","symbol":"href","name":"href","aliases":["링크 주소","하이퍼링크 참조"],"category":"link","description":"a, link 요소가 가리키는 주소(URL)를 지정합니다.","syntax":"<a href=\"URL\">","examples":["<a href=\"/docs\">문서</a>"],"related":["html.tag.a","html.tag.link"],"concepts":[],"appliesTo":["a","link","area"]},
    {"id":"html.attribute.target","symbol":"target","name":"target","aliases":["새 창","링크 대상"],"category":"link","description":"링크를 어디서 열지 지정합니다. _blank는 새 탭입니다.","syntax":"<a target=\"_blank\">","examples":["<a href=\"https://example.com\" target=\"_blank\" rel=\"noopener\">열기</a>"],"related":["html.tag.a"],"concepts":[],"appliesTo":["a","form","area"]},
    {"id":"html.attribute.src","symbol":"src","name":"src","aliases":["소스 경로","리소스 주소"],"category":"media","description":"img, script, video 등이 불러올 리소스의 주소를 지정합니다.","syntax":"<tag src=\"URL\">","examples":["<img src=\"photo.jpg\" alt=\"사진\">"],"related":["html.tag.img","html.tag.script","html.tag.video"],"concepts":[],"appliesTo":["img","script","video","audio","source","iframe","embed"]},
    {"id":"html.attribute.alt","symbol":"alt","name":"alt","aliases":["대체 텍스트"],"category":"media","description":"이미지를 볼 수 없을 때 보여 주거나 스크린 리더가 읽는 대체 텍스트.","syntax":"<img alt=\"TEXT\">","examples":["<img src=\"cat.png\" alt=\"잠든 고양이\">"],"related":["html.tag.img"],"concepts":[],"appliesTo":["img","area"]},
    {"id":"html.attribute.type","symbol":"type","name":"type","aliases":["입력 종류","타입"],"category":"form","description":"input의 입력 종류(text, email, number, checkbox 등)를 정합니다.","syntax":"<input type=\"KIND\">","examples":["<input type=\"number\" min=\"0\">"],"related":["html.tag.input"],"concepts":[],"appliesTo":["input","button","script","source","link"]},
    {"id":"html.attribute.name","symbol":"name","name":"name","aliases":["이름 속성","폼 필드 이름"],"category":"form","description":"폼 필드의 이름. 제출할 때 서버로 전달되는 키가 됩니다.","syntax":"<input name=\"NAME\">","examples":["<input name=\"email\">"],"related":["html.tag.input","html.tag.form"],"concepts":[],"appliesTo":["input","button","select","textarea","form","meta","fieldset","iframe"]},
    {"id":"html.attribute.value","symbol":"value","name":"value","aliases":["값","기본값"],"category":"form","description":"입력 요소의 현재 값 또는 기본값.","syntax":"<input value=\"TEXT\">","examples":["<input name=\"qty\" value=\"1\">"],"related":["html.tag.input"],"concepts":[],"appliesTo":["input","button","option","li","meter","progress","data"]},
    {"id":"html.attribute.placeholder","symbol":"placeholder","name":"placeholder","aliases":["플레이스홀더","안내 문구","힌트"],"category":"form","description":"입력창이 비어 있을 때 흐리게 보이는 안내 문구.","syntax":"<input placeholder=\"TEXT\">","examples":["<input placeholder=\"검색어를 입력하세요\">"],"related":["html.tag.input"],"concepts":[],"appliesTo":["input","textarea"]},
    {"id":"html.attribute.disabled","symbol":"disabled","name":"disabled","aliases":["비활성화"],"category":"form","description":"입력이나 버튼을 비활성화합니다. 값 없이 이름만 써도 됩니다.","syntax":"<button disabled>","examples":["<button disabled>전송</button>"],"related":["html.tag.button","html.tag.input"],"concepts":[],"appliesTo":["button","input","select","textarea","fieldset","optgroup","option"]},
    {"id":"html.attribute.width","symbol":"width","name":"width","aliases":["너비 속성","가로 크기 속성"],"category":"media","description":"이미지·캔버스·비디오 등의 가로 크기를 CSS 픽셀로 지정합니다. 단위 없이 숫자만 씁니다.","syntax":"<img width=\"N\">","examples":["<img src=\"a.png\" alt=\"\" width=\"320\" height=\"180\">"],"related":["html.attribute.height","html.tag.img","html.tag.canvas"],"concepts":[],"appliesTo":["img","canvas","video","iframe","embed","source","input"]},
    {"id":"html.attribute.height","symbol":"height","name":"height","aliases":["높이 속성","세로 크기 속성"],"category":"media","description":"이미지·캔버스·비디오 등의 세로 크기를 CSS 픽셀로 지정합니다. width와 함께 써 두면 로딩 중 레이아웃 흔들림이 줄어듭니다.","syntax":"<img height=\"N\">","examples":["<canvas width=\"300\" height=\"150\"></canvas>"],"related":["html.attribute.width","html.tag.img"],"concepts":[],"appliesTo":["img","canvas","video","iframe","embed","source","input"]},
    {"id":"html.attribute.loading","symbol":"loading","name":"loading","aliases":["지연 로딩","레이지 로딩","lazy"],"category":"media","description":"이미지나 iframe을 즉시 불러올지(eager), 화면 가까이 올 때 불러올지(lazy) 정합니다.","syntax":"<img loading=\"lazy\">","examples":["<img src=\"big.jpg\" alt=\"\" loading=\"lazy\">"],"related":["html.tag.img","html.tag.iframe"],"concepts":[],"appliesTo":["img","iframe"]},
    {"id":"html.attribute.srcset","symbol":"srcset","name":"srcset","aliases":["반응형 이미지 목록","해상도 후보"],"category":"media","description":"화면 밀도나 너비에 맞춰 브라우저가 고를 수 있는 이미지 후보 목록을 지정합니다.","syntax":"<img srcset=\"URL 1x, URL 2x\">","examples":["<img src=\"a.jpg\" srcset=\"a.jpg 1x, a@2x.jpg 2x\" alt=\"\">"],"related":["html.tag.img","html.tag.picture","html.attribute.src"],"concepts":[],"appliesTo":["img","source"]},
    {"id":"html.attribute.controls","symbol":"controls","name":"controls","aliases":["재생 컨트롤","플레이어 컨트롤"],"category":"media","description":"오디오·비디오에 브라우저 기본 재생 컨트롤을 표시합니다. 값 없이 이름만 씁니다.","syntax":"<video controls>","examples":["<audio src=\"a.mp3\" controls></audio>"],"related":["html.tag.audio","html.tag.video","html.attribute.autoplay"],"concepts":[],"appliesTo":["audio","video"]},
    {"id":"html.attribute.autoplay","symbol":"autoplay","name":"autoplay","aliases":["자동 재생"],"category":"media","description":"미디어를 준비되는 대로 자동 재생합니다. 브라우저 정책상 대개 muted와 함께 써야 동작합니다.","syntax":"<video autoplay muted>","examples":["<video src=\"loop.mp4\" autoplay muted loop></video>"],"related":["html.attribute.controls","html.tag.video"],"concepts":[],"appliesTo":["audio","video"]},
    {"id":"html.attribute.title","symbol":"title","name":"title","aliases":["툴팁","제목 속성","보조 설명"],"category":"global","description":"요소에 대한 부가 정보를 지정합니다. 보통 마우스를 올리면 툴팁으로 보입니다.","syntax":"<tag title=\"TEXT\">","examples":["<abbr title=\"World Wide Web\">WWW</abbr>"],"related":["html.tag.abbr","html.tag.title"],"concepts":[],"appliesTo":["*"]},
    {"id":"html.attribute.hidden","symbol":"hidden","name":"hidden","aliases":["숨김"],"category":"global","description":"요소를 화면에 표시하지 않습니다. 값 없이 이름만 씁니다.","syntax":"<tag hidden>","examples":["<p hidden>보이지 않는 문단</p>"],"related":["html.attribute.style"],"concepts":[],"appliesTo":["*"]},
    {"id":"html.attribute.tabindex","symbol":"tabindex","name":"tabindex","aliases":["탭 순서","포커스 순서"],"category":"global","description":"요소가 키보드로 포커스를 받을 수 있는지와 Tab 키 이동 순서를 정합니다. 0은 자연스러운 순서, -1은 스크립트로만 포커스됩니다.","syntax":"<tag tabindex=\"N\">","examples":["<div tabindex=\"0\" role=\"button\">클릭</div>"],"related":["html.tag.button"],"concepts":[],"appliesTo":["*"]},
    {"id":"html.attribute.open","symbol":"open","name":"open","aliases":["열림 상태"],"category":"interactive","description":"details나 dialog가 열려 있는 상태임을 나타냅니다.","syntax":"<details open>","examples":["<details open><summary>제목</summary>내용</details>"],"related":["html.tag.details","html.tag.dialog"],"concepts":[],"appliesTo":["details","dialog"]},
    {"id":"html.attribute.colspan","symbol":"colspan","name":"colspan","aliases":["열 합치기","가로 병합"],"category":"table","description":"표 셀이 차지하는 열의 수를 지정합니다.","syntax":"<td colspan=\"N\">","examples":["<td colspan=\"3\">전체</td>"],"related":["html.attribute.rowspan","html.tag.td","html.tag.th"],"concepts":[],"appliesTo":["td","th"]},
    {"id":"html.attribute.rowspan","symbol":"rowspan","name":"rowspan","aliases":["행 합치기","세로 병합"],"category":"table","description":"표 셀이 차지하는 행의 수를 지정합니다.","syntax":"<td rowspan=\"N\">","examples":["<td rowspan=\"2\">합쳐진 셀</td>"],"related":["html.attribute.colspan","html.tag.td"],"concepts":[],"appliesTo":["td","th"]},
    {"id":"html.attribute.required","symbol":"required","name":"required","aliases":["필수 입력"],"category":"form","description":"폼을 제출하기 전에 반드시 값을 입력해야 하는 필드로 지정합니다. 브라우저가 기본 검증을 합니다.","syntax":"<input required>","examples":["<input type=\"email\" name=\"email\" required>"],"related":["html.tag.input","html.attribute.pattern"],"concepts":[],"appliesTo":["input","select","textarea"]},
    {"id":"html.attribute.readonly","symbol":"readonly","name":"readonly","aliases":["읽기 전용"],"category":"form","description":"사용자가 값을 수정할 수 없게 하되 폼 제출에는 포함합니다. disabled는 제출에서도 빠집니다.","syntax":"<input readonly>","examples":["<input name=\"id\" value=\"A-100\" readonly>"],"related":["html.attribute.disabled","html.tag.input"],"concepts":[],"appliesTo":["input","textarea"]},
    {"id":"html.attribute.checked","symbol":"checked","name":"checked","aliases":["체크됨","기본 선택"],"category":"form","description":"체크박스나 라디오 버튼이 처음부터 선택된 상태로 지정합니다.","syntax":"<input type=\"checkbox\" checked>","examples":["<input type=\"checkbox\" name=\"agree\" checked>"],"related":["html.attribute.type","html.tag.input"],"concepts":[],"appliesTo":["input"]},
    {"id":"html.attribute.selected","symbol":"selected","name":"selected","aliases":["선택됨","기본 선택 항목"],"category":"form","description":"option이 처음부터 선택된 상태로 지정합니다.","syntax":"<option selected>","examples":["<option value=\"ko\" selected>한국어</option>"],"related":["html.tag.option","html.tag.select"],"concepts":[],"appliesTo":["option"]},
    {"id":"html.attribute.min","symbol":"min","name":"min","aliases":["최솟값"],"category":"form","description":"숫자, 날짜, 범위 입력과 meter, progress가 받을 수 있는 최솟값을 지정합니다.","syntax":"<input type=\"number\" min=\"N\">","examples":["<input type=\"number\" min=\"1\" max=\"10\">"],"related":["html.attribute.max","html.tag.meter"],"concepts":[],"appliesTo":["input","meter"]},
    {"id":"html.attribute.max","symbol":"max","name":"max","aliases":["최댓값"],"category":"form","description":"숫자, 날짜, 범위 입력과 meter, progress가 받을 수 있는 최댓값을 지정합니다.","syntax":"<input type=\"number\" max=\"N\">","examples":["<progress value=\"3\" max=\"10\"></progress>"],"related":["html.attribute.min","html.tag.progress","html.tag.meter"],"concepts":[],"appliesTo":["input","meter","progress"]},
    {"id":"html.attribute.maxlength","symbol":"maxlength","name":"maxlength","aliases":["최대 글자 수","글자 수 제한"],"category":"form","description":"텍스트 입력에서 허용되는 최대 글자(UTF-16 코드 단위) 수를 지정합니다.","syntax":"<input maxlength=\"N\">","examples":["<input name=\"nick\" maxlength=\"12\">"],"related":["html.tag.input","html.tag.textarea"],"concepts":[],"appliesTo":["input","textarea"]},
    {"id":"html.attribute.pattern","symbol":"pattern","name":"pattern","aliases":["정규식 검증","입력 패턴"],"category":"form","description":"입력 값이 맞아야 하는 정규식을 지정합니다. 값 전체가 일치해야 하며 title로 설명을 덧붙이면 좋습니다.","syntax":"<input pattern=\"REGEX\">","examples":["<input pattern=\"[0-9]{3}-[0-9]{4}\" title=\"123-4567 형식\">"],"related":["html.attribute.required","html.tag.input"],"concepts":[],"appliesTo":["input"]},
    {"id":"html.attribute.multiple","symbol":"multiple","name":"multiple","aliases":["다중 선택","여러 개"],"category":"form","description":"여러 값을 선택하거나 여러 파일을 고를 수 있게 합니다.","syntax":"<select multiple>","examples":["<input type=\"file\" name=\"photos\" multiple>"],"related":["html.tag.select","html.tag.input"],"concepts":[],"appliesTo":["input","select"]},
    {"id":"html.attribute.action","symbol":"action","name":"action","aliases":["폼 전송 주소","제출 URL"],"category":"form","description":"폼 데이터를 보낼 서버 주소를 지정합니다.","syntax":"<form action=\"URL\">","examples":["<form action=\"/search\" method=\"get\">"],"related":["html.tag.form","html.attribute.method"],"concepts":[],"appliesTo":["form"]},
    {"id":"html.attribute.method","symbol":"method","name":"method","aliases":["폼 전송 방식","GET POST"],"category":"form","description":"폼 제출에 쓸 HTTP 방식을 지정합니다. get(주소에 붙임), post(본문에 담음), dialog가 있습니다.","syntax":"<form method=\"post\">","examples":["<form action=\"/login\" method=\"post\">"],"related":["html.tag.form","html.attribute.action"],"concepts":[],"appliesTo":["form"]},
    {"id":"html.attribute.for","symbol":"for","name":"for","aliases":["라벨 연결","for 속성"],"category":"form","description":"label을 id가 같은 입력 요소와 연결합니다. output에서는 계산에 쓰인 요소를 가리킵니다.","syntax":"<label for=\"ID\">","examples":["<label for=\"pw\">비밀번호</label><input id=\"pw\" type=\"password\">"],"related":["html.tag.label","html.attribute.id"],"concepts":[],"appliesTo":["label","output"]},
    {"id":"html.attribute.rel","symbol":"rel","name":"rel","aliases":["관계 속성","링크 관계","noopener"],"category":"link","description":"현재 문서와 링크된 리소스의 관계를 지정합니다. stylesheet, icon, noopener, preload 같은 키워드를 씁니다.","syntax":"<link rel=\"KEYWORD\" href=\"URL\">","examples":["<link rel=\"icon\" href=\"/favicon.png\">","<a href=\"https://example.com\" target=\"_blank\" rel=\"noopener noreferrer\">링크</a>"],"related":["html.tag.link","html.tag.a","html.attribute.target"],"concepts":[],"appliesTo":["a","link","area","form"]},
    {"id":"html.attribute.download","symbol":"download","name":"download","aliases":["다운로드 속성","파일 저장"],"category":"link","description":"링크를 이동하지 않고 파일로 저장하게 합니다. 값은 저장될 파일 이름 제안입니다.","syntax":"<a href=\"URL\" download=\"NAME\">","examples":["<a href=\"report.pdf\" download=\"보고서.pdf\">내려받기</a>"],"related":["html.tag.a","html.attribute.href"],"concepts":[],"appliesTo":["a","area"]},
    {"id":"html.attribute.charset","symbol":"charset","name":"charset","aliases":["문자 인코딩","인코딩"],"category":"document","description":"문서의 문자 인코딩을 선언합니다. 현대 웹은 utf-8만 사용하며 문서 앞쪽 1024바이트 안에 있어야 합니다.","syntax":"<meta charset=\"utf-8\">","examples":["<meta charset=\"utf-8\">"],"related":["html.tag.meta"],"concepts":[],"appliesTo":["meta"]},
    {"id":"html.attribute.content","symbol":"content","name":"content","aliases":["메타 내용"],"category":"document","description":"meta 요소의 name 또는 http-equiv와 짝을 이루는 값을 지정합니다.","syntax":"<meta name=\"NAME\" content=\"VALUE\">","examples":["<meta name=\"description\" content=\"페이지 설명\">"],"related":["html.tag.meta","html.attribute.name"],"concepts":[],"appliesTo":["meta"]},
    {"id":"html.attribute.defer","symbol":"defer","name":"defer","aliases":["지연 실행","스크립트 지연"],"category":"scripting","description":"스크립트를 HTML 파싱과 병렬로 내려받고, 문서 파싱이 끝난 뒤 순서대로 실행합니다.","syntax":"<script src=\"URL\" defer></script>","examples":["<script src=\"app.js\" defer></script>"],"related":["html.attribute.async","html.tag.script"],"concepts":[],"appliesTo":["script"]},
    {"id":"html.attribute.async","symbol":"async","name":"async","aliases":["비동기 스크립트"],"category":"scripting","description":"스크립트를 병렬로 내려받고, 받는 즉시(순서 보장 없이) 실행합니다. 독립적인 스크립트에 적합합니다.","syntax":"<script src=\"URL\" async></script>","examples":["<script src=\"analytics.js\" async></script>"],"related":["html.attribute.defer","html.tag.script"],"concepts":[],"appliesTo":["script"]},
    {"id":"html.attribute.crossorigin","symbol":"crossorigin","name":"crossorigin","aliases":["교차 출처","CORS 요청"],"category":"scripting","description":"다른 출처의 리소스를 CORS 방식으로 요청할지, 쿠키를 보낼지 지정합니다. anonymous 또는 use-credentials.","syntax":"<script src=\"URL\" crossorigin=\"anonymous\">","examples":["<img src=\"https://cdn.example.com/a.png\" alt=\"\" crossorigin=\"anonymous\">"],"related":["html.tag.script","html.tag.img"],"concepts":[],"appliesTo":["img","script","link","audio","video"]}
  ]
}
