{
  "schemaVersion": "1.0.0", "language": "html", "type": "tag", "entryVersion": "1.0.0",
  "entries": [
    {"id":"html.tag.html","symbol":"<html>","name":"html","aliases":["루트 요소","문서 루트"],"category":"document","description":"HTML 문서의 최상위 루트 요소. lang 속성으로 문서 언어를 지정합니다.","syntax":"<html lang=\"ko\">...</html>","examples":["<html lang=\"ko\">"],"related":["html.tag.head","html.tag.body","html.attribute.lang"],"concepts":[]},
    {"id":"html.tag.head","symbol":"<head>","name":"head","aliases":["헤드","메타 정보 영역"],"category":"document","description":"제목, 메타데이터, 스타일, 스크립트 등 화면에 직접 보이지 않는 문서 정보를 담습니다.","syntax":"<head>...</head>","examples":["<head><title>제목</title></head>"],"related":["html.tag.title","html.tag.meta","html.tag.link"],"concepts":[]},
    {"id":"html.tag.body","symbol":"<body>","name":"body","aliases":["바디","본문"],"category":"document","description":"브라우저 화면에 표시되는 문서의 본문 전체를 담습니다.","syntax":"<body>...</body>","examples":["<body><h1>안녕</h1></body>"],"related":["html.tag.html"],"concepts":[]},
    {"id":"html.tag.title","symbol":"<title>","name":"title","aliases":["문서 제목","탭 제목"],"category":"document","description":"브라우저 탭과 검색 결과에 표시되는 문서 제목을 지정합니다.","syntax":"<title>TEXT</title>","examples":["<title>IEUM CodingDictionary</title>"],"related":["html.tag.head"],"concepts":[]},
    {"id":"html.tag.meta","symbol":"<meta>","name":"meta","aliases":["메타 태그","메타데이터"],"category":"document","description":"문자 인코딩, 뷰포트, 설명 등 문서에 대한 메타데이터를 지정하는 빈 요소.","syntax":"<meta name=\"NAME\" content=\"VALUE\">","examples":["<meta charset=\"utf-8\">","<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"],"related":["html.tag.head","html.attribute.name"],"concepts":[]},
    {"id":"html.tag.link","symbol":"<link>","name":"link","aliases":["링크 태그","스타일시트 연결"],"category":"document","description":"외부 CSS 파일이나 아이콘 같은 외부 리소스를 문서에 연결하는 빈 요소.","syntax":"<link rel=\"stylesheet\" href=\"URL\">","examples":["<link rel=\"stylesheet\" href=\"style.css\">"],"related":["html.tag.head","html.attribute.href"],"concepts":["concept.module-import"]},
    {"id":"html.tag.script","symbol":"<script>","name":"script","aliases":["스크립트","자바스크립트 삽입"],"category":"document","description":"JavaScript 코드를 직접 넣거나 src로 외부 스크립트 파일을 불러옵니다.","syntax":"<script src=\"URL\"></script>","examples":["<script src=\"app.js\" defer></script>","<script type=\"module\" src=\"main.js\"></script>"],"related":["html.attribute.src"],"concepts":["concept.module-import"]},
    {"id":"html.tag.style","symbol":"<style>","name":"style","aliases":["스타일 태그","내부 CSS"],"category":"document","description":"문서 안에 CSS 규칙을 직접 작성합니다.","syntax":"<style>CSS</style>","examples":["<style>body { margin: 0; }</style>"],"related":["html.tag.link","html.attribute.style"],"concepts":[]},
    {"id":"html.tag.div","symbol":"<div>","name":"div","aliases":["디브","영역","박스","컨테이너"],"category":"structure","description":"콘텐츠를 하나의 영역으로 묶는 범용 블록 요소. 의미는 없고 레이아웃과 스타일링에 쓰입니다.","syntax":"<div>CONTENT</div>","examples":["<div class=\"card\">내용</div>"],"related":["html.tag.span","html.tag.section","html.attribute.class"],"concepts":[]},
    {"id":"html.tag.span","symbol":"<span>","name":"span","aliases":["스팬","인라인 영역"],"category":"text","description":"문장 안의 일부 텍스트를 묶는 범용 인라인 요소.","syntax":"<span>TEXT</span>","examples":["<p>가격: <span class=\"price\">1,000원</span></p>"],"related":["html.tag.div"],"concepts":[]},
    {"id":"html.tag.p","symbol":"<p>","name":"p","aliases":["문단","단락","paragraph"],"category":"text","description":"하나의 문단을 나타내는 블록 요소.","syntax":"<p>TEXT</p>","examples":["<p>첫 번째 문단입니다.</p>"],"related":["html.tag.h1"],"concepts":[]},
    {"id":"html.tag.h1","symbol":"<h1>","name":"h1","aliases":["제목","헤딩","h2","h3","h4","h5","h6"],"category":"text","description":"문서의 제목을 나타냅니다. h1(가장 중요)부터 h6(가장 덜 중요)까지 6단계가 있습니다.","syntax":"<h1>TITLE</h1>","examples":["<h1>페이지 제목</h1>","<h2>소제목</h2>"],"related":["html.tag.p"],"concepts":[]},
    {"id":"html.tag.a","symbol":"<a>","name":"a","aliases":["링크","앵커","하이퍼링크"],"category":"link","description":"다른 페이지, 파일, 문서 내 위치로 이동하는 하이퍼링크를 만듭니다.","syntax":"<a href=\"URL\">TEXT</a>","examples":["<a href=\"https://example.com\" target=\"_blank\" rel=\"noopener\">예시</a>"],"related":["html.attribute.href","html.attribute.target"],"concepts":[]},
    {"id":"html.tag.img","symbol":"<img>","name":"img","aliases":["이미지","그림","사진"],"category":"media","description":"이미지를 문서에 삽입하는 빈 요소. 접근성을 위해 alt 속성을 함께 씁니다.","syntax":"<img src=\"URL\" alt=\"TEXT\">","examples":["<img src=\"logo.png\" alt=\"IEUM 로고\">"],"related":["html.attribute.src","html.attribute.alt"],"concepts":[]},
    {"id":"html.tag.video","symbol":"<video>","name":"video","aliases":["비디오","동영상"],"category":"media","description":"동영상을 재생하는 요소. controls 속성으로 재생 컨트롤을 표시합니다.","syntax":"<video src=\"URL\" controls></video>","examples":["<video src=\"intro.mp4\" controls></video>"],"related":["html.attribute.src"],"concepts":[]},
    {"id":"html.tag.ul","symbol":"<ul>","name":"ul","aliases":["순서 없는 목록","불릿 목록","unordered list"],"category":"list","description":"순서가 없는 목록. 항목은 li 요소로 작성합니다.","syntax":"<ul><li>ITEM</li></ul>","examples":["<ul><li>사과</li><li>배</li></ul>"],"related":["html.tag.ol","html.tag.li"],"concepts":["concept.collection"]},
    {"id":"html.tag.ol","symbol":"<ol>","name":"ol","aliases":["순서 있는 목록","번호 목록","ordered list"],"category":"list","description":"순서가 있는(번호가 매겨지는) 목록.","syntax":"<ol><li>ITEM</li></ol>","examples":["<ol><li>첫째</li><li>둘째</li></ol>"],"related":["html.tag.ul","html.tag.li"],"concepts":["concept.collection"]},
    {"id":"html.tag.li","symbol":"<li>","name":"li","aliases":["목록 항목","list item"],"category":"list","description":"ul, ol 안의 목록 항목 하나.","syntax":"<li>ITEM</li>","examples":["<li>항목</li>"],"related":["html.tag.ul","html.tag.ol"],"concepts":[]},
    {"id":"html.tag.table","symbol":"<table>","name":"table","aliases":["표","테이블"],"category":"table","description":"행(tr)과 셀(td, th)로 이루어진 표를 만듭니다.","syntax":"<table><tr><th>HEAD</th></tr><tr><td>CELL</td></tr></table>","examples":["<table><tr><th>이름</th><th>나이</th></tr><tr><td>가온</td><td>20</td></tr></table>"],"related":[],"concepts":[]},
    {"id":"html.tag.form","symbol":"<form>","name":"form","aliases":["폼","양식","입력 양식"],"category":"form","description":"사용자 입력을 모아 서버로 전송하는 양식 영역.","syntax":"<form action=\"URL\" method=\"post\">...</form>","examples":["<form action=\"/login\" method=\"post\"><input name=\"id\"><button>로그인</button></form>"],"related":["html.tag.input","html.tag.button","html.tag.label"],"concepts":[]},
    {"id":"html.tag.input","symbol":"<input>","name":"input","aliases":["입력창","인풋","텍스트 입력"],"category":"form","description":"텍스트, 체크박스, 숫자 등 사용자 입력을 받는 빈 요소. type 속성으로 종류를 정합니다.","syntax":"<input type=\"text\" name=\"NAME\">","examples":["<input type=\"email\" placeholder=\"이메일\">","<input type=\"checkbox\" name=\"agree\">"],"related":["html.tag.label","html.attribute.type","html.attribute.name","html.attribute.placeholder"],"concepts":[]},
    {"id":"html.tag.button","symbol":"<button>","name":"button","aliases":["버튼","단추"],"category":"form","description":"클릭할 수 있는 버튼. form 안에서는 기본적으로 제출 버튼으로 동작합니다.","syntax":"<button type=\"button\">TEXT</button>","examples":["<button type=\"submit\">전송</button>"],"related":["html.tag.form","html.attribute.disabled"],"concepts":[]},
    {"id":"html.tag.label","symbol":"<label>","name":"label","aliases":["라벨","레이블"],"category":"form","description":"입력 요소에 이름표를 붙입니다. 라벨을 클릭하면 연결된 입력에 포커스가 갑니다.","syntax":"<label for=\"ID\">TEXT</label>","examples":["<label for=\"email\">이메일</label><input id=\"email\">"],"related":["html.tag.input","html.attribute.id"],"concepts":[]},
    {"id":"html.tag.select","symbol":"<select>","name":"select","aliases":["드롭다운","선택 상자","셀렉트"],"category":"form","description":"여러 option 중 하나를 고르는 드롭다운 목록.","syntax":"<select name=\"NAME\"><option value=\"V\">TEXT</option></select>","examples":["<select name=\"lang\"><option value=\"ko\">한국어</option><option value=\"en\">English</option></select>"],"related":["html.tag.input"],"concepts":[]},
    {"id":"html.tag.textarea","symbol":"<textarea>","name":"textarea","aliases":["여러 줄 입력","텍스트 영역"],"category":"form","description":"여러 줄의 텍스트를 입력하는 입력창.","syntax":"<textarea name=\"NAME\" rows=\"4\"></textarea>","examples":["<textarea name=\"memo\" rows=\"4\" cols=\"30\"></textarea>"],"related":["html.tag.input"],"concepts":[]},
    {"id":"html.tag.header","symbol":"<header>","name":"header","aliases":["헤더","머리글"],"category":"semantic","description":"페이지나 섹션의 머리글 영역. 로고, 제목, 내비게이션 등을 담습니다.","syntax":"<header>...</header>","examples":["<header><h1>사이트 이름</h1></header>"],"related":["html.tag.nav","html.tag.footer"],"concepts":[]},
    {"id":"html.tag.nav","symbol":"<nav>","name":"nav","aliases":["내비게이션","메뉴"],"category":"semantic","description":"주요 이동 링크 모음(내비게이션)을 나타내는 시맨틱 요소.","syntax":"<nav><a href=\"URL\">TEXT</a></nav>","examples":["<nav><a href=\"/\">홈</a><a href=\"/about\">소개</a></nav>"],"related":["html.tag.a","html.tag.header"],"concepts":[]},
    {"id":"html.tag.main","symbol":"<main>","name":"main","aliases":["메인","주요 콘텐츠"],"category":"semantic","description":"문서의 핵심 콘텐츠 영역. 문서당 하나만 사용합니다.","syntax":"<main>...</main>","examples":["<main><article>...</article></main>"],"related":["html.tag.article","html.tag.section"],"concepts":[]},
    {"id":"html.tag.section","symbol":"<section>","name":"section","aliases":["섹션","구역"],"category":"semantic","description":"주제별로 나뉜 문서의 한 구역. 보통 제목(h1~h6)을 함께 둡니다.","syntax":"<section><h2>TITLE</h2>...</section>","examples":["<section><h2>소개</h2><p>...</p></section>"],"related":["html.tag.article","html.tag.div"],"concepts":[]},
    {"id":"html.tag.article","symbol":"<article>","name":"article","aliases":["아티클","글","독립 콘텐츠"],"category":"semantic","description":"블로그 글, 뉴스처럼 그 자체로 독립해 배포될 수 있는 콘텐츠.","syntax":"<article>...</article>","examples":["<article><h2>제목</h2><p>본문</p></article>"],"related":["html.tag.section","html.tag.main"],"concepts":[]},
    {"id":"html.tag.footer","symbol":"<footer>","name":"footer","aliases":["푸터","바닥글"],"category":"semantic","description":"페이지나 섹션의 바닥글 영역. 저작권, 연락처 등을 담습니다.","syntax":"<footer>...</footer>","examples":["<footer><p>© 2026 IEUM</p></footer>"],"related":["html.tag.header"],"concepts":[]},
    {"id":"html.tag.base","symbol":"<base>","name":"base","aliases":["기준 주소","베이스 URL"],"category":"document","description":"문서 안의 모든 상대 URL이 기준으로 삼는 주소를 지정합니다. 문서에 하나만 둘 수 있습니다.","syntax":"<base href=\"URL\" target=\"_blank\">","examples":["<base href=\"https://example.com/docs/\">"],"related":["html.tag.head","html.attribute.href"],"concepts":[]},
    {"id":"html.tag.noscript","symbol":"<noscript>","name":"noscript","aliases":["노스크립트","스크립트 꺼짐 대체"],"category":"scripting","description":"스크립트가 지원되지 않거나 꺼져 있을 때 대신 보여 줄 내용을 담습니다.","syntax":"<noscript>CONTENT</noscript>","examples":["<noscript>이 페이지는 JavaScript가 필요합니다.</noscript>"],"related":["html.tag.script"],"concepts":[]},
    {"id":"html.tag.canvas","symbol":"<canvas>","name":"canvas","aliases":["캔버스","그래픽 영역"],"category":"scripting","description":"JavaScript(Canvas API, WebGL)로 그래픽과 애니메이션을 그리는 영역입니다.","syntax":"<canvas id=\"ID\" width=\"W\" height=\"H\"></canvas>","examples":["<canvas id=\"board\" width=\"300\" height=\"150\"></canvas>"],"related":["html.attribute.width","html.attribute.height","html.tag.script"],"concepts":[]},
    {"id":"html.tag.template","symbol":"<template>","name":"template","aliases":["템플릿","렌더링 안 되는 조각"],"category":"scripting","description":"페이지 로드 때 바로 그려지지 않고, 나중에 JavaScript로 복제해 쓰는 HTML 조각을 담습니다.","syntax":"<template>CONTENT</template>","examples":["<template id=\"row\"><li class=\"item\"></li></template>"],"related":["html.tag.script"],"concepts":[]},
    {"id":"html.tag.aside","symbol":"<aside>","name":"aside","aliases":["사이드바","보조 콘텐츠"],"category":"semantic","description":"본문과 간접적으로만 관련된 내용(사이드바, 콜아웃 상자 등)을 나타냅니다.","syntax":"<aside>CONTENT</aside>","examples":["<aside><h2>관련 글</h2></aside>"],"related":["html.tag.main","html.tag.section"],"concepts":[]},
    {"id":"html.tag.address","symbol":"<address>","name":"address","aliases":["연락처","주소 정보"],"category":"semantic","description":"사람이나 조직의 연락처 정보를 나타냅니다. 우편 주소 전용이 아니라 이메일, 전화번호 등도 담을 수 있습니다.","syntax":"<address>CONTACT</address>","examples":["<address>문의: <a href=\"mailto:hi@example.com\">hi@example.com</a></address>"],"related":["html.tag.footer","html.tag.a"],"concepts":[]},
    {"id":"html.tag.blockquote","symbol":"<blockquote>","name":"blockquote","aliases":["인용문","긴 인용"],"category":"text","description":"여러 줄에 걸친 긴 인용문을 나타냅니다. 출처 주소는 cite 속성으로 지정합니다.","syntax":"<blockquote cite=\"URL\">TEXT</blockquote>","examples":["<blockquote cite=\"https://example.com\"><p>인용할 글</p></blockquote>"],"related":["html.tag.q","html.tag.cite"],"concepts":[]},
    {"id":"html.tag.q","symbol":"<q>","name":"q","aliases":["짧은 인용","인라인 인용"],"category":"text","description":"문장 안의 짧은 인용을 나타냅니다. 브라우저가 따옴표를 자동으로 붙입니다.","syntax":"<q>TEXT</q>","examples":["<p>그는 <q>안녕</q>이라고 말했다.</p>"],"related":["html.tag.blockquote"],"concepts":[]},
    {"id":"html.tag.cite","symbol":"<cite>","name":"cite","aliases":["출처","작품 제목"],"category":"text","description":"책, 논문, 영화 같은 창작물의 제목을 표시합니다.","syntax":"<cite>TITLE</cite>","examples":["<cite>해리 포터와 마법사의 돌</cite>"],"related":["html.tag.blockquote"],"concepts":[]},
    {"id":"html.tag.figure","symbol":"<figure>","name":"figure","aliases":["피규어","그림 묶음","도해"],"category":"media","description":"이미지, 도표, 코드 등 독립적인 콘텐츠를 캡션과 함께 하나로 묶습니다. 캡션은 figcaption으로 씁니다.","syntax":"<figure>CONTENT<figcaption>CAPTION</figcaption></figure>","examples":["<figure><img src=\"a.png\" alt=\"차트\"><figcaption>그림 1. 월별 방문자</figcaption></figure>"],"related":["html.tag.figcaption","html.tag.img"],"concepts":[]},
    {"id":"html.tag.figcaption","symbol":"<figcaption>","name":"figcaption","aliases":["그림 설명","캡션"],"category":"media","description":"figure 요소 안에서 그 내용을 설명하는 캡션입니다.","syntax":"<figcaption>TEXT</figcaption>","examples":["<figure><img src=\"a.png\" alt=\"\"><figcaption>설명</figcaption></figure>"],"related":["html.tag.figure"],"concepts":[]},
    {"id":"html.tag.hr","symbol":"<hr>","name":"hr","aliases":["가로줄","구분선","수평선"],"category":"text","description":"문단 사이의 주제 전환을 나타내는 구분선입니다. 닫는 태그가 없는 빈 요소입니다.","syntax":"<hr>","examples":["<p>1장 끝</p><hr><p>2장 시작</p>"],"related":["html.tag.p","html.tag.br"],"concepts":[]},
    {"id":"html.tag.br","symbol":"<br>","name":"br","aliases":["줄바꿈","개행","line break"],"category":"text","description":"텍스트 안에서 줄을 바꿉니다. 시나 주소처럼 줄 구분이 의미가 있을 때만 쓰고, 간격 조절에는 CSS를 씁니다.","syntax":"<br>","examples":["<p>서울시<br>중구 세종대로 110</p>"],"related":["html.tag.p","html.tag.hr"],"concepts":[]},
    {"id":"html.tag.em","symbol":"<em>","name":"em","aliases":["강조","이탤릭","emphasis"],"category":"text","description":"말할 때 강세를 주는 것처럼 의미상 강조할 텍스트입니다. 중첩할수록 더 강한 강조가 됩니다.","syntax":"<em>TEXT</em>","examples":["<p>나는 <em>정말</em> 좋아해.</p>"],"related":["html.tag.strong","html.tag.mark"],"concepts":[]},
    {"id":"html.tag.strong","symbol":"<strong>","name":"strong","aliases":["굵게","중요","strong importance"],"category":"text","description":"내용이 중요하거나 심각하거나 긴급함을 나타냅니다. 보통 굵은 글씨로 보입니다.","syntax":"<strong>TEXT</strong>","examples":["<p><strong>경고:</strong> 되돌릴 수 없습니다.</p>"],"related":["html.tag.em"],"concepts":[]},
    {"id":"html.tag.small","symbol":"<small>","name":"small","aliases":["작은 글씨","부가 설명","저작권 문구"],"category":"text","description":"저작권 표시나 법적 고지 같은 부수적인 작은 글씨를 나타냅니다.","syntax":"<small>TEXT</small>","examples":["<small>© 2026 IEUM</small>"],"related":["html.tag.footer"],"concepts":[]},
    {"id":"html.tag.code","symbol":"<code>","name":"code","aliases":["코드","인라인 코드"],"category":"text","description":"짧은 컴퓨터 코드 조각을 나타냅니다. 기본적으로 고정폭 글꼴로 표시됩니다.","syntax":"<code>CODE</code>","examples":["<p>배열은 <code>[1, 2, 3]</code>처럼 씁니다.</p>"],"related":["html.tag.pre","html.tag.kbd"],"concepts":[]},
    {"id":"html.tag.pre","symbol":"<pre>","name":"pre","aliases":["서식 있는 텍스트","코드 블록","preformatted"],"category":"text","description":"공백과 줄바꿈을 입력한 그대로 보여 주는 미리 서식이 정해진 텍스트입니다. 여러 줄 코드는 보통 pre 안에 code를 넣습니다.","syntax":"<pre>TEXT</pre>","examples":["<pre><code>a = 1\nb = 2</code></pre>"],"related":["html.tag.code"],"concepts":[]},
    {"id":"html.tag.kbd","symbol":"<kbd>","name":"kbd","aliases":["키보드 입력","단축키 표시"],"category":"text","description":"키보드 등 사용자가 입력하는 텍스트를 나타냅니다.","syntax":"<kbd>KEY</kbd>","examples":["<p>저장: <kbd>Ctrl</kbd>+<kbd>S</kbd></p>"],"related":["html.tag.code"],"concepts":[]},
    {"id":"html.tag.abbr","symbol":"<abbr>","name":"abbr","aliases":["약어","줄임말"],"category":"text","description":"약어나 두문자어를 나타냅니다. title 속성에 풀이를 적을 수 있습니다.","syntax":"<abbr title=\"FULL\">ABBR</abbr>","examples":["<abbr title=\"HyperText Markup Language\">HTML</abbr>"],"related":["html.attribute.title"],"concepts":[]},
    {"id":"html.tag.time","symbol":"<time>","name":"time","aliases":["시간","날짜","datetime"],"category":"text","description":"특정 시각이나 기간을 나타냅니다. datetime 속성에 기계가 읽을 수 있는 형식으로 적습니다.","syntax":"<time datetime=\"YYYY-MM-DD\">TEXT</time>","examples":["<time datetime=\"2026-10-09\">10월 9일</time>"],"related":[],"concepts":[]},
    {"id":"html.tag.mark","symbol":"<mark>","name":"mark","aliases":["하이라이트","형광펜","표시"],"category":"text","description":"현재 맥락에서 관련 있어 눈에 띄게 표시한 텍스트입니다. 검색어 강조에 자주 씁니다.","syntax":"<mark>TEXT</mark>","examples":["<p>검색어 <mark>코딩</mark>이 포함된 글</p>"],"related":["html.tag.em"],"concepts":[]},
    {"id":"html.tag.iframe","symbol":"<iframe>","name":"iframe","aliases":["아이프레임","내장 페이지","프레임"],"category":"embedded","description":"다른 HTML 문서를 현재 문서 안에 중첩해서 보여 줍니다. 보안을 위해 sandbox 속성을 함께 쓰는 것이 좋습니다.","syntax":"<iframe src=\"URL\" title=\"TEXT\"></iframe>","examples":["<iframe src=\"https://example.com\" title=\"예시\" sandbox></iframe>"],"related":["html.attribute.src","html.attribute.loading"],"concepts":[]},
    {"id":"html.tag.audio","symbol":"<audio>","name":"audio","aliases":["오디오","소리","음악"],"category":"media","description":"문서에 소리를 넣습니다. controls 속성으로 재생 컨트롤을 표시하고, source 요소로 여러 형식을 제공할 수 있습니다.","syntax":"<audio src=\"URL\" controls></audio>","examples":["<audio src=\"song.mp3\" controls></audio>"],"related":["html.tag.video","html.tag.source","html.attribute.controls"],"concepts":[]},
    {"id":"html.tag.source","symbol":"<source>","name":"source","aliases":["미디어 소스","대체 형식"],"category":"media","description":"picture, audio, video가 고를 수 있는 여러 리소스 후보를 지정하는 빈 요소입니다.","syntax":"<source src=\"URL\" type=\"MIME\">","examples":["<video controls><source src=\"a.webm\" type=\"video/webm\"><source src=\"a.mp4\" type=\"video/mp4\"></video>"],"related":["html.tag.picture","html.tag.video","html.tag.audio"],"concepts":[]},
    {"id":"html.tag.picture","symbol":"<picture>","name":"picture","aliases":["반응형 이미지","픽처"],"category":"media","description":"여러 source와 하나의 img를 담아 화면 크기나 형식에 따라 알맞은 이미지를 고르게 합니다.","syntax":"<picture><source srcset=\"URL\" media=\"QUERY\"><img src=\"URL\" alt=\"TEXT\"></picture>","examples":["<picture><source srcset=\"wide.webp\" media=\"(min-width: 800px)\"><img src=\"small.jpg\" alt=\"풍경\"></picture>"],"related":["html.tag.source","html.tag.img","html.attribute.srcset"],"concepts":[]},
    {"id":"html.tag.details","symbol":"<details>","name":"details","aliases":["접기","펼치기","아코디언"],"category":"interactive","description":"펼치고 접을 수 있는 공개 위젯입니다. 제목은 summary 요소로 지정합니다.","syntax":"<details><summary>TITLE</summary>CONTENT</details>","examples":["<details open><summary>자세히</summary><p>숨겨진 내용</p></details>"],"related":["html.tag.summary","html.attribute.open"],"concepts":[]},
    {"id":"html.tag.summary","symbol":"<summary>","name":"summary","aliases":["요약","접기 제목"],"category":"interactive","description":"details 요소의 제목입니다. 클릭하면 details가 열리고 닫힙니다.","syntax":"<summary>TEXT</summary>","examples":["<details><summary>FAQ</summary>답변</details>"],"related":["html.tag.details"],"concepts":[]},
    {"id":"html.tag.dialog","symbol":"<dialog>","name":"dialog","aliases":["대화상자","모달","팝업"],"category":"interactive","description":"대화상자나 모달 같은 상호작용 창을 나타냅니다. showModal()로 모달로 열고 close()로 닫습니다.","syntax":"<dialog id=\"ID\">CONTENT</dialog>","examples":["<dialog id=\"dlg\"><p>확인할까요?</p><button>닫기</button></dialog>"],"related":["html.attribute.open","html.tag.button"],"concepts":[]},
    {"id":"html.tag.thead","symbol":"<thead>","name":"thead","aliases":["표 머리","테이블 헤드"],"category":"table","description":"표의 머리 행(열 제목)들을 묶습니다.","syntax":"<thead><tr><th>HEAD</th></tr></thead>","examples":["<table><thead><tr><th>이름</th></tr></thead></table>"],"related":["html.tag.table","html.tag.tbody","html.tag.th"],"concepts":[]},
    {"id":"html.tag.tbody","symbol":"<tbody>","name":"tbody","aliases":["표 본문","테이블 바디"],"category":"table","description":"표의 본문 행들을 묶습니다.","syntax":"<tbody><tr><td>CELL</td></tr></tbody>","examples":["<table><tbody><tr><td>가온</td></tr></tbody></table>"],"related":["html.tag.table","html.tag.thead","html.tag.tr"],"concepts":[]},
    {"id":"html.tag.tr","symbol":"<tr>","name":"tr","aliases":["표 행","테이블 로우"],"category":"table","description":"표의 한 행입니다. 안에 td(데이터 셀)와 th(제목 셀)를 넣습니다.","syntax":"<tr><td>CELL</td></tr>","examples":["<tr><td>1</td><td>2</td></tr>"],"related":["html.tag.td","html.tag.th","html.tag.table"],"concepts":[]},
    {"id":"html.tag.td","symbol":"<td>","name":"td","aliases":["표 셀","데이터 셀"],"category":"table","description":"표의 데이터 셀입니다. colspan, rowspan으로 셀을 합칠 수 있습니다.","syntax":"<td>DATA</td>","examples":["<tr><td colspan=\"2\">합계</td></tr>"],"related":["html.tag.tr","html.tag.th","html.attribute.colspan"],"concepts":[]},
    {"id":"html.tag.th","symbol":"<th>","name":"th","aliases":["표 제목 셀","헤더 셀"],"category":"table","description":"표의 제목 셀입니다. scope 속성으로 행 제목인지 열 제목인지 지정합니다.","syntax":"<th scope=\"col\">HEAD</th>","examples":["<tr><th scope=\"col\">이름</th><th scope=\"col\">점수</th></tr>"],"related":["html.tag.td","html.tag.tr"],"concepts":[]},
    {"id":"html.tag.fieldset","symbol":"<fieldset>","name":"fieldset","aliases":["필드셋","입력 그룹"],"category":"form","description":"폼의 관련 입력들을 하나로 묶습니다. 제목은 legend 요소로 지정합니다.","syntax":"<fieldset><legend>TITLE</legend>CONTROLS</fieldset>","examples":["<fieldset><legend>성별</legend><label><input type=\"radio\" name=\"g\"> 남</label></fieldset>"],"related":["html.tag.legend","html.tag.form"],"concepts":[]},
    {"id":"html.tag.legend","symbol":"<legend>","name":"legend","aliases":["범례","그룹 제목"],"category":"form","description":"부모 fieldset의 제목(캡션)입니다.","syntax":"<legend>TEXT</legend>","examples":["<fieldset><legend>배송지</legend></fieldset>"],"related":["html.tag.fieldset"],"concepts":[]},
    {"id":"html.tag.option","symbol":"<option>","name":"option","aliases":["옵션","선택 항목"],"category":"form","description":"select, optgroup, datalist 안의 선택 항목 하나입니다.","syntax":"<option value=\"V\">TEXT</option>","examples":["<option value=\"ko\" selected>한국어</option>"],"related":["html.tag.select","html.tag.datalist","html.attribute.selected"],"concepts":[]},
    {"id":"html.tag.datalist","symbol":"<datalist>","name":"datalist","aliases":["자동완성 목록","입력 후보"],"category":"form","description":"다른 입력 컨트롤이 제안할 수 있는 값(option)들을 담습니다. input의 list 속성으로 연결합니다.","syntax":"<input list=\"ID\"><datalist id=\"ID\"><option value=\"V\"></datalist>","examples":["<input list=\"fruits\"><datalist id=\"fruits\"><option value=\"사과\"><option value=\"배\"></datalist>"],"related":["html.tag.option","html.tag.input"],"concepts":[]},
    {"id":"html.tag.progress","symbol":"<progress>","name":"progress","aliases":["진행률","프로그레스 바"],"category":"form","description":"작업의 완료 진행 상황을 막대로 보여 줍니다. value와 max 속성을 씁니다.","syntax":"<progress value=\"N\" max=\"M\"></progress>","examples":["<progress value=\"30\" max=\"100\"></progress>"],"related":["html.tag.meter","html.attribute.max"],"concepts":[]},
    {"id":"html.tag.meter","symbol":"<meter>","name":"meter","aliases":["미터","게이지","측정값"],"category":"form","description":"알려진 범위 안의 값(디스크 사용량, 점수 등)을 게이지로 보여 줍니다. 진행 상황에는 progress를 씁니다.","syntax":"<meter value=\"N\" min=\"A\" max=\"B\"></meter>","examples":["<meter value=\"0.6\" min=\"0\" max=\"1\"></meter>"],"related":["html.tag.progress","html.attribute.min","html.attribute.max"],"concepts":[]}
  ]
}
