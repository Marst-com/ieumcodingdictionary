{
  "schemaVersion": "1.0.0", "language": "javascript", "type": "grammar", "entryVersion": "1.0.0",
  "entries": [
    {"id": "javascript.grammar.function-declaration", "symbol": "function f() {}", "name": "Function Declaration", "aliases": ["함수 선언문", "함수 선언"], "category": "declaration", "description": "이름 있는 함수를 선언하는 문법. 호이스팅되어 선언보다 위에서도 호출할 수 있습니다.", "syntax": "function NAME(PARAMS) { BODY }", "examples": ["function add(a, b) {\n  return a + b;\n}"], "related": ["javascript.keyword.function", "javascript.keyword.return", "javascript.grammar.arrow-function"], "concepts": ["concept.function"], "tree": {"node": "FUNCTION_DECLARATION", "children": [{"node": "KEYWORD", "text": "function"}, {"node": "IDENTIFIER", "text": "add"}, {"node": "PARAMETER_LIST", "text": "(a, b)"}, {"node": "BLOCK", "children": [{"node": "RETURN_STATEMENT", "children": [{"node": "KEYWORD", "text": "return"}, {"node": "EXPRESSION", "text": "a + b"}]}]}]}},
    {"id": "javascript.grammar.arrow-function", "symbol": "() => {}", "name": "Arrow Function Expression", "aliases": ["화살표 함수 식", "애로우 함수"], "category": "expression", "description": "함수를 식으로 짧게 쓰는 문법. 본문이 식 하나면 중괄호와 return을 생략합니다.", "syntax": "(PARAMS) => EXPRESSION", "examples": ["const add = (a, b) => a + b;"], "related": ["javascript.operator.arrow", "javascript.grammar.function-declaration"], "concepts": ["concept.function"], "tree": {"node": "VARIABLE_DECLARATION", "children": [{"node": "KEYWORD", "text": "const"}, {"node": "IDENTIFIER", "text": "add"}, {"node": "ARROW_FUNCTION", "children": [{"node": "PARAMETER_LIST", "text": "(a, b)"}, {"node": "ARROW", "text": "=>"}, {"node": "EXPRESSION", "text": "a + b"}]}]}},
    {"id": "javascript.grammar.if-statement", "symbol": "if () {}", "name": "If Statement", "aliases": ["if 문", "조건문 문법"], "category": "statement", "description": "조건식이 참이면 블록을 실행하고, else 블록으로 거짓일 때를 처리하는 문장.", "syntax": "if (CONDITION) { THEN } else { ELSE }", "examples": ["if (score >= 60) {\n  pass();\n} else {\n  retry();\n}"], "related": ["javascript.keyword.if", "javascript.keyword.else", "javascript.operator.ternary"], "concepts": ["concept.conditional"], "tree": {"node": "IF_STATEMENT", "children": [{"node": "KEYWORD", "text": "if"}, {"node": "CONDITION", "text": "(score >= 60)"}, {"node": "BLOCK", "text": "{ pass(); }"}, {"node": "ELSE_CLAUSE", "children": [{"node": "KEYWORD", "text": "else"}, {"node": "BLOCK", "text": "{ retry(); }"}]}]}},
    {"id": "javascript.grammar.for-loop", "symbol": "for (;;) {}", "name": "For Statement", "aliases": ["for 반복문", "for 문법"], "category": "statement", "description": "초기화, 조건, 증감 세 부분과 본문 블록으로 이루어진 반복 문장.", "syntax": "for (INIT; TEST; UPDATE) { BODY }", "examples": ["for (let i = 0; i < 3; i++) {\n  console.log(i);\n}"], "related": ["javascript.keyword.for", "javascript.operator.increment"], "concepts": ["concept.loop"], "tree": {"node": "FOR_STATEMENT", "children": [{"node": "KEYWORD", "text": "for"}, {"node": "INIT", "text": "let i = 0"}, {"node": "TEST", "text": "i < 3"}, {"node": "UPDATE", "text": "i++"}, {"node": "BLOCK", "text": "{ console.log(i); }"}]}},
    {"id": "javascript.grammar.class-declaration", "symbol": "class {}", "name": "Class Declaration", "aliases": ["클래스 선언문", "클래스 문법"], "category": "declaration", "description": "생성자와 메서드를 가진 클래스를 선언하는 문법.", "syntax": "class NAME extends PARENT { constructor() { ... } METHOD() { ... } }", "examples": ["class Counter {\n  constructor() { this.n = 0; }\n  inc() { this.n++; }\n}"], "related": ["javascript.keyword.class", "javascript.keyword.new", "javascript.keyword.this"], "concepts": ["concept.class"], "tree": {"node": "CLASS_DECLARATION", "children": [{"node": "KEYWORD", "text": "class"}, {"node": "IDENTIFIER", "text": "Counter"}, {"node": "CLASS_BODY", "children": [{"node": "CONSTRUCTOR", "text": "constructor() { this.n = 0; }"}, {"node": "METHOD", "text": "inc() { this.n++; }"}]}]}},
    {"id": "javascript.grammar.try-catch", "symbol": "try {} catch {}", "name": "Try Statement", "aliases": ["try catch 문법", "예외 처리 문법"], "category": "statement", "description": "오류가 날 수 있는 코드를 try에 두고 catch로 처리하는 문장. finally는 선택입니다.", "syntax": "try { BODY } catch (ERROR) { HANDLER } finally { CLEANUP }", "examples": ["try {\n  run();\n} catch (e) {\n  console.error(e);\n}"], "related": ["javascript.keyword.try", "javascript.keyword.throw"], "concepts": ["concept.error-handling"], "tree": {"node": "TRY_STATEMENT", "children": [{"node": "KEYWORD", "text": "try"}, {"node": "BLOCK", "text": "{ run(); }"}, {"node": "CATCH_CLAUSE", "children": [{"node": "KEYWORD", "text": "catch"}, {"node": "PARAMETER", "text": "(e)"}, {"node": "BLOCK", "text": "{ console.error(e); }"}]}]}},
    {"id": "javascript.grammar.while-statement", "symbol": "while () {}", "name": "While Statement", "aliases": ["while 문", "조건 반복 문법"], "category": "statement", "description": "조건식이 참인 동안 본문을 반복하는 문장. 조건은 본문 실행 전에 검사합니다.", "syntax": "while (CONDITION) { BODY }", "examples": ["let i = 0;\nwhile (i < 3) {\n  i++;\n}"], "related": ["javascript.keyword.while", "javascript.keyword.do", "python.keyword.while"], "concepts": ["concept.loop"], "tree": {"node": "WHILE_STATEMENT", "children": [{"node": "KEYWORD", "text": "while"}, {"node": "CONDITION", "text": "(i < 3)"}, {"node": "BLOCK", "text": "{ i++; }"}]}},
    {"id": "javascript.grammar.switch-statement", "symbol": "switch () {}", "name": "Switch Statement", "aliases": ["switch 문", "다중 분기 문법"], "category": "statement", "description": "값 하나를 여러 case와 비교해 일치하는 곳부터 실행합니다. 각 case 끝에서 break하지 않으면 다음 case로 이어집니다.", "syntax": "switch (VALUE) {\n  case A: ...; break;\n  default: ...\n}", "examples": ["switch (day) {\n  case 0:\n    label = \"일\";\n    break;\n  default:\n    label = \"평일\";\n}"], "related": ["javascript.keyword.switch", "javascript.keyword.break", "javascript.grammar.if-statement"], "concepts": ["concept.conditional"], "tree": {"node": "SWITCH_STATEMENT", "children": [{"node": "KEYWORD", "text": "switch"}, {"node": "DISCRIMINANT", "text": "(day)"}, {"node": "CASE_CLAUSE", "children": [{"node": "KEYWORD", "text": "case"}, {"node": "TEST", "text": "0"}, {"node": "BLOCK", "text": "label = \"일\"; break;"}]}, {"node": "DEFAULT_CLAUSE", "children": [{"node": "KEYWORD", "text": "default"}, {"node": "BLOCK", "text": "label = \"평일\";"}]}]}},
    {"id": "javascript.grammar.destructuring", "symbol": "{ a } = obj", "name": "Destructuring Assignment", "aliases": ["구조 분해 할당", "구조분해", "비구조화"], "category": "expression", "description": "배열이나 객체의 값을 한 번에 여러 변수로 꺼내는 문법. 기본값과 이름 바꾸기도 지원합니다.", "syntax": "const { A, B: ALIAS = DEFAULT } = OBJECT;\nconst [X, Y] = ARRAY;", "examples": ["const { name, age = 20 } = user;\nconst [first, second] = [1, 2];"], "related": ["javascript.operator.spread", "javascript.function.object-entries", "javascript.keyword.const"], "concepts": ["concept.variable", "concept.collection"], "tree": {"node": "VARIABLE_DECLARATION", "children": [{"node": "KEYWORD", "text": "const"}, {"node": "OBJECT_PATTERN", "children": [{"node": "PROPERTY", "text": "name"}, {"node": "PROPERTY_WITH_DEFAULT", "text": "age = 20"}]}, {"node": "INITIALIZER", "text": "user"}]}},
    {"id": "javascript.grammar.async-function", "symbol": "async function", "name": "Async Function", "aliases": ["비동기 함수 문법", "async await 문법"], "category": "declaration", "description": "async로 선언한 함수 안에서 await로 Promise 결과를 순서대로 기다리는 문법. 오류는 try...catch로 처리합니다.", "syntax": "async function NAME() {\n  const RESULT = await PROMISE;\n}", "examples": ["async function load(url) {\n  const res = await fetch(url);\n  return res.json();\n}"], "related": ["javascript.keyword.async", "javascript.keyword.await", "javascript.function.fetch", "javascript.grammar.try-catch"], "concepts": ["concept.function", "concept.concurrency"], "tree": {"node": "ASYNC_FUNCTION_DECLARATION", "children": [{"node": "KEYWORD", "text": "async function"}, {"node": "IDENTIFIER", "text": "load"}, {"node": "PARAMETER_LIST", "text": "(url)"}, {"node": "BLOCK", "children": [{"node": "VARIABLE_DECLARATION", "text": "const res = await fetch(url)"}, {"node": "RETURN_STATEMENT", "text": "return res.json()"}]}]}}
  ]
}
