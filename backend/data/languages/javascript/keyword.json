{
  "schemaVersion": "1.0.0", "language": "javascript", "type": "keyword", "entryVersion": "1.0.0",
  "entries": [
    {"id": "javascript.keyword.function", "symbol": "function", "name": "function", "aliases": ["함수", "함수 선언", "함수 정의"], "category": "declaration", "description": "함수를 선언하는 키워드. 이름, 매개변수 목록, 본문 블록으로 이루어집니다.", "syntax": "function NAME(PARAMS) { BODY }", "examples": ["function add(a, b) { return a + b; }"], "related": ["javascript.grammar.function-declaration", "javascript.operator.arrow", "javascript.keyword.return"], "concepts": ["concept.function"]},
    {"id": "javascript.keyword.const", "symbol": "const", "name": "const", "aliases": ["상수", "상수 선언", "constant"], "category": "declaration", "description": "재할당할 수 없는 블록 범위 변수를 선언합니다. 객체나 배열 내부 값은 바꿀 수 있습니다.", "syntax": "const NAME = VALUE;", "examples": ["const PI = 3.14;", "const user = { name: \"가온\" };"], "related": ["javascript.keyword.let", "javascript.keyword.var"], "concepts": ["concept.variable"]},
    {"id": "javascript.keyword.let", "symbol": "let", "name": "let", "aliases": ["변수", "변수 선언", "let 변수"], "category": "declaration", "description": "재할당할 수 있는 블록 범위 변수를 선언합니다.", "syntax": "let NAME = VALUE;", "examples": ["let count = 0; count += 1;"], "related": ["javascript.keyword.const", "javascript.keyword.var"], "concepts": ["concept.variable"]},
    {"id": "javascript.keyword.var", "symbol": "var", "name": "var", "aliases": ["var 변수", "옛날 변수 선언"], "category": "declaration", "description": "함수 범위를 가지는 오래된 변수 선언. 호이스팅 때문에 혼란이 생기기 쉬워 보통 let, const를 씁니다.", "syntax": "var NAME = VALUE;", "examples": ["var legacy = 1;"], "related": ["javascript.keyword.let", "javascript.keyword.const"], "concepts": ["concept.variable"]},
    {"id": "javascript.keyword.if", "symbol": "if", "name": "if", "aliases": ["조건문", "만약", "if 문"], "category": "control-flow", "description": "조건이 참일 때만 블록을 실행합니다.", "syntax": "if (CONDITION) { BODY }", "examples": ["if (age >= 18) { console.log(\"성인\"); }"], "related": ["javascript.keyword.else", "javascript.grammar.if-statement", "javascript.keyword.switch"], "concepts": ["concept.conditional"]},
    {"id": "javascript.keyword.else", "symbol": "else", "name": "else", "aliases": ["아니면", "else if"], "category": "control-flow", "description": "if 조건이 거짓일 때 실행할 블록을 지정합니다. else if로 조건을 이어 붙일 수 있습니다.", "syntax": "if (A) { ... } else { ... }", "examples": ["if (n > 0) { pos(); } else if (n < 0) { neg(); } else { zero(); }"], "related": ["javascript.keyword.if"], "concepts": ["concept.conditional"]},
    {"id": "javascript.keyword.switch", "symbol": "switch", "name": "switch", "aliases": ["스위치", "다중 분기"], "category": "control-flow", "description": "하나의 값을 여러 case와 비교해 분기합니다. 각 case 끝에 break가 없으면 아래 case로 이어서 실행됩니다.", "syntax": "switch (VALUE) { case X: ...; break; default: ... }", "examples": ["switch (day) { case 0: name = \"일\"; break; default: name = \"평일\"; }"], "related": ["javascript.keyword.break", "javascript.keyword.if"], "concepts": ["concept.conditional"]},
    {"id": "javascript.keyword.for", "symbol": "for", "name": "for", "aliases": ["반복문", "for 문", "for of", "for in"], "category": "control-flow", "description": "초기화·조건·증감으로 반복하거나, for...of로 값을, for...in으로 키를 순회합니다.", "syntax": "for (INIT; CONDITION; UPDATE) { BODY }", "examples": ["for (let i = 0; i < 3; i++) { console.log(i); }", "for (const x of [1, 2, 3]) { console.log(x); }"], "related": ["javascript.grammar.for-loop", "javascript.keyword.while", "javascript.keyword.break"], "concepts": ["concept.loop"]},
    {"id": "javascript.keyword.while", "symbol": "while", "name": "while", "aliases": ["와일", "조건 반복"], "category": "control-flow", "description": "조건이 참인 동안 블록을 반복합니다.", "syntax": "while (CONDITION) { BODY }", "examples": ["while (queue.length) { queue.pop(); }"], "related": ["javascript.keyword.for", "javascript.keyword.break", "javascript.keyword.continue"], "concepts": ["concept.loop"]},
    {"id": "javascript.keyword.break", "symbol": "break", "name": "break", "aliases": ["중단", "반복 탈출"], "category": "control-flow", "description": "가장 가까운 반복문이나 switch를 즉시 빠져나갑니다.", "syntax": "break;", "examples": ["for (const x of list) { if (x === 3) break; }"], "related": ["javascript.keyword.continue", "javascript.keyword.for", "javascript.keyword.switch"], "concepts": ["concept.loop"]},
    {"id": "javascript.keyword.continue", "symbol": "continue", "name": "continue", "aliases": ["건너뛰기", "다음 반복"], "category": "control-flow", "description": "현재 반복의 나머지를 건너뛰고 다음 반복으로 넘어갑니다.", "syntax": "continue;", "examples": ["for (const n of nums) { if (n % 2) continue; console.log(n); }"], "related": ["javascript.keyword.break", "javascript.keyword.for"], "concepts": ["concept.loop"]},
    {"id": "javascript.keyword.return", "symbol": "return", "name": "return", "aliases": ["반환", "리턴", "반환값"], "category": "function", "description": "함수 실행을 끝내고 값을 호출한 쪽에 돌려줍니다. 값이 없으면 undefined를 반환합니다.", "syntax": "return VALUE;", "examples": ["return a + b;"], "related": ["javascript.keyword.function", "javascript.operator.arrow"], "concepts": ["concept.return-value", "concept.function"]},
    {"id": "javascript.keyword.async", "symbol": "async", "name": "async", "aliases": ["비동기 함수", "어싱크"], "category": "async", "description": "함수를 비동기 함수로 만듭니다. 항상 Promise를 반환하고 안에서 await를 쓸 수 있습니다.", "syntax": "async function NAME() { ... }", "examples": ["async function load() { const res = await fetch(url); return res.json(); }"], "related": ["javascript.keyword.await", "javascript.function.fetch"], "concepts": ["concept.function", "concept.concurrency"]},
    {"id": "javascript.keyword.await", "symbol": "await", "name": "await", "aliases": ["기다리기", "어웨이트"], "category": "async", "description": "Promise가 완료될 때까지 async 함수의 실행을 멈추고 결과 값을 받습니다.", "syntax": "await PROMISE", "examples": ["const data = await fetch(\"/api/v1/languages\").then(r => r.json());"], "related": ["javascript.keyword.async", "javascript.function.fetch"], "concepts": ["concept.concurrency"]},
    {"id": "javascript.keyword.class", "symbol": "class", "name": "class", "aliases": ["클래스", "클래스 선언", "객체 설계도"], "category": "object", "description": "생성자와 메서드를 가진 객체의 설계도를 선언합니다. extends로 상속합니다.", "syntax": "class NAME { constructor() { ... } METHOD() { ... } }", "examples": ["class Dog extends Animal { bark() { return \"멍\"; } }"], "related": ["javascript.grammar.class-declaration", "javascript.keyword.new", "javascript.keyword.this"], "concepts": ["concept.class"]},
    {"id": "javascript.keyword.new", "symbol": "new", "name": "new", "aliases": ["인스턴스 생성", "객체 생성"], "category": "object", "description": "클래스나 생성자 함수로 새 객체(인스턴스)를 만듭니다.", "syntax": "new CLASS(ARGS)", "examples": ["const d = new Dog(\"초코\");", "const now = new Date();"], "related": ["javascript.keyword.class"], "concepts": ["concept.class"]},
    {"id": "javascript.keyword.this", "symbol": "this", "name": "this", "aliases": ["디스", "자기 자신", "현재 객체"], "category": "object", "description": "현재 실행 문맥의 객체를 가리킵니다. 메서드에서는 보통 그 메서드를 호출한 객체입니다. 화살표 함수는 바깥의 this를 그대로 씁니다.", "syntax": "this.PROPERTY", "examples": ["class P { constructor(n) { this.name = n; } }"], "related": ["javascript.keyword.class", "javascript.operator.arrow"], "concepts": ["concept.class"]},
    {"id": "javascript.keyword.try", "symbol": "try", "name": "try...catch", "aliases": ["예외 처리", "에러 처리", "트라이 캐치", "catch", "finally"], "category": "error", "description": "try 블록에서 발생한 오류를 catch에서 처리합니다. finally는 성공·실패와 관계없이 마지막에 실행됩니다.", "syntax": "try { ... } catch (e) { ... } finally { ... }", "examples": ["try { JSON.parse(text); } catch (e) { console.error(e.message); }"], "related": ["javascript.keyword.throw", "javascript.grammar.try-catch", "javascript.function.json-parse"], "concepts": ["concept.error-handling"]},
    {"id": "javascript.keyword.throw", "symbol": "throw", "name": "throw", "aliases": ["에러 던지기", "예외 발생"], "category": "error", "description": "오류를 직접 발생시켜 현재 흐름을 중단하고 가까운 catch로 넘깁니다.", "syntax": "throw new Error(MESSAGE);", "examples": ["if (!id) throw new Error(\"id가 필요합니다\");"], "related": ["javascript.keyword.try"], "concepts": ["concept.error-handling"]},
    {"id": "javascript.keyword.import", "symbol": "import", "name": "import", "aliases": ["모듈 가져오기", "임포트"], "category": "module", "description": "ES 모듈에서 다른 파일이 export한 값을 가져옵니다. import()는 동적으로 불러옵니다.", "syntax": "import { NAME } from \"PATH\";", "examples": ["import { search } from \"./search-engine.js\";", "const m = await import(\"./lazy.js\");"], "related": ["javascript.keyword.export"], "concepts": ["concept.module-import"]},
    {"id": "javascript.keyword.export", "symbol": "export", "name": "export", "aliases": ["모듈 내보내기", "익스포트"], "category": "module", "description": "ES 모듈의 값을 다른 파일에서 import할 수 있도록 내보냅니다.", "syntax": "export const NAME = VALUE; export default VALUE;", "examples": ["export function add(a, b) { return a + b; }"], "related": ["javascript.keyword.import"], "concepts": ["concept.module-import"]},
    {"id": "javascript.keyword.typeof", "symbol": "typeof", "name": "typeof", "aliases": ["타입 확인", "자료형 확인"], "category": "operator", "description": "값의 자료형을 나타내는 문자열을 반환합니다. null은 \"object\"로 나오는 점에 주의하세요.", "syntax": "typeof VALUE", "examples": ["typeof 42 // \"number\"", "typeof \"a\" // \"string\""], "related": ["javascript.operator.strict-equality"], "concepts": []},
    {"id": "javascript.keyword.null", "symbol": "null", "name": "null", "aliases": ["널", "없음", "빈 값"], "category": "literal", "description": "\"의도적으로 비어 있음\"을 나타내는 값. typeof null은 \"object\"로 나오는 오래된 특성이 있습니다. 값이 아예 정해지지 않은 경우는 undefined입니다.", "syntax": "null", "examples": ["let user = null;", "if (user === null) { }"], "related": ["javascript.operator.nullish-coalescing", "javascript.operator.optional-chaining", "javascript.keyword.typeof"], "concepts": ["concept.null-value"]},
    {"id": "javascript.keyword.true", "symbol": "true", "name": "true", "aliases": ["참", "불리언 참"], "category": "literal", "description": "불리언 참 값.", "syntax": "true", "examples": ["const ready = true;"], "related": ["javascript.keyword.false", "javascript.operator.logical-not"], "concepts": ["concept.boolean-logic", "concept.data-type"]},
    {"id": "javascript.keyword.false", "symbol": "false", "name": "false", "aliases": ["거짓", "불리언 거짓"], "category": "literal", "description": "불리언 거짓 값. 0, \"\", null, undefined, NaN도 조건식에서 거짓처럼 취급됩니다(falsy).", "syntax": "false", "examples": ["let done = false;"], "related": ["javascript.keyword.true", "javascript.operator.logical-not"], "concepts": ["concept.boolean-logic", "concept.data-type"]},
    {"id": "javascript.keyword.do", "symbol": "do", "name": "do...while", "aliases": ["두 와일", "최소 한 번 실행 반복", "do while"], "category": "control-flow", "description": "본문을 먼저 한 번 실행한 뒤 조건을 검사해 반복합니다. 조건이 처음부터 거짓이어도 한 번은 실행됩니다.", "syntax": "do { BODY } while (CONDITION);", "examples": ["let n = 0;\ndo { n++; } while (n < 3);"], "related": ["javascript.keyword.while", "javascript.keyword.for"], "concepts": ["concept.loop"]},
    {"id": "javascript.keyword.in", "symbol": "in", "name": "in", "aliases": ["인", "속성 존재 확인", "for in"], "category": "operator", "description": "객체(또는 프로토타입 체인)에 속성 이름이 있는지 검사합니다. for...in에서는 열거 가능한 속성 이름을 순회합니다.", "syntax": "\"KEY\" in OBJECT", "examples": ["\"name\" in { name: \"가온\" }"], "related": ["javascript.keyword.for", "javascript.keyword.of", "javascript.function.object-keys"], "concepts": ["concept.collection"]},
    {"id": "javascript.keyword.of", "symbol": "of", "name": "of", "aliases": ["오브", "for of", "값 순회"], "category": "control-flow", "description": "for...of에서 배열, 문자열, Set 같은 반복 가능한 객체의 값을 하나씩 꺼냅니다.", "syntax": "for (const ITEM of ITERABLE) { BODY }", "examples": ["for (const ch of \"abc\") { console.log(ch); }"], "related": ["javascript.keyword.for", "javascript.keyword.in"], "concepts": ["concept.loop"]},
    {"id": "javascript.keyword.instanceof", "symbol": "instanceof", "name": "instanceof", "aliases": ["인스턴스 확인", "클래스 확인"], "category": "operator", "description": "객체가 특정 생성자(클래스)의 프로토타입 체인에 속하는지 검사합니다.", "syntax": "OBJECT instanceof CONSTRUCTOR", "examples": ["[] instanceof Array", "new Date() instanceof Date"], "related": ["javascript.keyword.typeof", "javascript.keyword.class"], "concepts": ["concept.class", "concept.data-type"]},
    {"id": "javascript.keyword.delete", "symbol": "delete", "name": "delete", "aliases": ["속성 삭제", "삭제"], "category": "operator", "description": "객체의 속성을 삭제합니다. 변수나 배열 요소의 \"자리\"를 지우는 용도는 아닙니다.", "syntax": "delete OBJECT.PROPERTY", "examples": ["const o = { a: 1 }; delete o.a;"], "related": ["javascript.keyword.in"], "concepts": []},
    {"id": "javascript.keyword.extends", "symbol": "extends", "name": "extends", "aliases": ["상속", "부모 클래스", "확장"], "category": "object", "description": "클래스가 다른 클래스를 상속받게 합니다. 자식 생성자에서는 this를 쓰기 전에 super()를 호출해야 합니다.", "syntax": "class CHILD extends PARENT { ... }", "examples": ["class Dog extends Animal { }"], "related": ["javascript.keyword.super", "javascript.keyword.class"], "concepts": ["concept.inheritance", "concept.class"]},
    {"id": "javascript.keyword.super", "symbol": "super", "name": "super", "aliases": ["부모 호출", "슈퍼"], "category": "object", "description": "부모 클래스의 생성자(super())나 메서드(super.method())를 호출합니다.", "syntax": "super(ARGS)  super.METHOD(ARGS)", "examples": ["class B extends A { constructor() { super(); } }"], "related": ["javascript.keyword.extends", "javascript.keyword.class"], "concepts": ["concept.inheritance"]},
    {"id": "javascript.keyword.static", "symbol": "static", "name": "static", "aliases": ["정적 메서드", "클래스 메서드"], "category": "object", "description": "인스턴스가 아니라 클래스 자체에 속하는 메서드나 필드를 선언합니다.", "syntax": "class NAME { static METHOD() { ... } }", "examples": ["class Util { static double(n) { return n * 2; } }\nUtil.double(4);"], "related": ["javascript.keyword.class", "javascript.keyword.new"], "concepts": ["concept.class"]},
    {"id": "javascript.keyword.yield", "symbol": "yield", "name": "yield", "aliases": ["제너레이터", "값 내보내기"], "category": "function", "description": "제너레이터 함수(function*)에서 값을 하나 내보내고 실행을 잠시 멈춥니다.", "syntax": "function* NAME() { yield VALUE; }", "examples": ["function* count() { yield 1; yield 2; }"], "related": ["javascript.keyword.function", "python.keyword.yield"], "concepts": ["concept.function"]}
  ]
}
