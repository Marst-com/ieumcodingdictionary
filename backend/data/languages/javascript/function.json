{
  "schemaVersion": "1.0.0", "language": "javascript", "type": "function", "entryVersion": "1.0.0",
  "entries": [
    {"id": "javascript.function.console-log", "symbol": "console.log()", "name": "console.log", "aliases": ["콘솔 출력", "출력", "로그", "print"], "category": "debug", "description": "값을 개발자 도구 콘솔에 출력합니다.", "syntax": "console.log(VALUE, ...)", "examples": ["console.log(\"안녕\", 42);"], "related": [], "concepts": []},
    {"id": "javascript.function.array-map", "symbol": ".map()", "name": "Array.prototype.map", "aliases": ["map", "맵", "배열 변환"], "category": "array", "description": "각 요소에 함수를 적용한 결과로 새 배열을 만듭니다. 원본은 바뀌지 않습니다.", "syntax": "ARRAY.map((item, index) => RESULT)", "examples": ["[1, 2, 3].map(n => n * 2) // [2, 4, 6]"], "related": ["javascript.function.array-filter", "javascript.function.array-reduce", "javascript.function.array-foreach"], "concepts": ["concept.collection"]},
    {"id": "javascript.function.array-filter", "symbol": ".filter()", "name": "Array.prototype.filter", "aliases": ["filter", "필터", "배열 걸러내기"], "category": "array", "description": "조건 함수가 true를 반환한 요소만 모아 새 배열을 만듭니다.", "syntax": "ARRAY.filter(item => CONDITION)", "examples": ["[1, 2, 3, 4].filter(n => n % 2 === 0) // [2, 4]"], "related": ["javascript.function.array-map", "javascript.function.array-reduce"], "concepts": ["concept.collection"]},
    {"id": "javascript.function.array-reduce", "symbol": ".reduce()", "name": "Array.prototype.reduce", "aliases": ["reduce", "리듀스", "배열 합치기", "누적"], "category": "array", "description": "요소를 하나씩 누적해 단일 값으로 줄입니다. 초기값을 두 번째 인자로 줍니다.", "syntax": "ARRAY.reduce((acc, item) => NEXT, INITIAL)", "examples": ["[1, 2, 3].reduce((sum, n) => sum + n, 0) // 6"], "related": ["javascript.function.array-map", "javascript.function.array-filter"], "concepts": ["concept.collection", "concept.aggregation"]},
    {"id": "javascript.function.array-foreach", "symbol": ".forEach()", "name": "Array.prototype.forEach", "aliases": ["forEach", "포이치", "배열 순회"], "category": "array", "description": "각 요소에 대해 함수를 한 번씩 실행합니다. 반환값이 없으며 중간에 break할 수 없습니다.", "syntax": "ARRAY.forEach((item, index) => { ... })", "examples": ["[\"a\", \"b\"].forEach(s => console.log(s));"], "related": ["javascript.function.array-map", "javascript.keyword.for"], "concepts": ["concept.collection", "concept.loop"]},
    {"id": "javascript.function.object-keys", "symbol": "Object.keys()", "name": "Object.keys", "aliases": ["객체 키 목록", "keys"], "category": "object", "description": "객체가 가진 고유 열거 가능 속성 이름을 배열로 반환합니다.", "syntax": "Object.keys(OBJECT)", "examples": ["Object.keys({ a: 1, b: 2 }) // [\"a\", \"b\"]"], "related": ["javascript.function.array-map"], "concepts": ["concept.collection"]},
    {"id": "javascript.function.json-stringify", "symbol": "JSON.stringify()", "name": "JSON.stringify", "aliases": ["JSON 문자열로 변환", "직렬화", "stringify"], "category": "json", "description": "JavaScript 값을 JSON 문자열로 바꿉니다.", "syntax": "JSON.stringify(VALUE, REPLACER, SPACE)", "examples": ["JSON.stringify({ a: 1 }, null, 2)"], "related": ["javascript.function.json-parse"], "concepts": []},
    {"id": "javascript.function.json-parse", "symbol": "JSON.parse()", "name": "JSON.parse", "aliases": ["JSON 파싱", "역직렬화", "parse"], "category": "json", "description": "JSON 문자열을 JavaScript 값으로 바꿉니다. 문법이 틀리면 SyntaxError를 던집니다.", "syntax": "JSON.parse(TEXT)", "examples": ["JSON.parse('{\"a\":1}').a // 1"], "related": ["javascript.function.json-stringify", "javascript.keyword.try"], "concepts": []},
    {"id": "javascript.function.fetch", "symbol": "fetch()", "name": "fetch", "aliases": ["페치", "API 호출", "HTTP 요청", "네트워크 요청"], "category": "network", "description": "HTTP 요청을 보내고 Promise<Response>를 반환합니다. HTTP 오류 상태에서도 reject되지 않으므로 response.ok를 확인해야 합니다.", "syntax": "fetch(URL, OPTIONS)", "examples": ["const res = await fetch(\"/api/v1/languages\"); if (!res.ok) throw new Error(res.status);"], "related": ["javascript.keyword.await", "javascript.keyword.async", "javascript.function.json-parse"], "concepts": []},
    {"id": "javascript.function.set-timeout", "symbol": "setTimeout()", "name": "setTimeout", "aliases": ["타이머", "지연 실행", "디바운스"], "category": "timer", "description": "지정한 시간(ms) 뒤에 함수를 한 번 실행합니다. clearTimeout으로 취소합니다.", "syntax": "setTimeout(CALLBACK, MS)", "examples": ["const id = setTimeout(() => save(), 150); clearTimeout(id);"], "related": [], "concepts": []},
    {"id": "javascript.function.parse-int", "symbol": "parseInt()", "name": "parseInt", "aliases": ["정수 변환", "문자열을 숫자로"], "category": "number", "description": "문자열을 정수로 변환합니다. 두 번째 인자로 진법을 지정하는 것이 안전합니다.", "syntax": "parseInt(TEXT, RADIX)", "examples": ["parseInt(\"42px\", 10) // 42"], "related": [], "concepts": []},
    {"id": "javascript.function.array-find", "symbol": ".find()", "name": "Array.prototype.find", "aliases": ["find", "찾기", "조건에 맞는 첫 요소"], "category": "array", "description": "조건 함수를 처음 만족하는 요소를 반환합니다. 없으면 undefined입니다.", "syntax": "ARRAY.find(item => CONDITION)", "examples": ["[1, 5, 8].find(n => n > 3) // 5"], "related": ["javascript.function.array-filter", "javascript.function.array-includes"], "concepts": ["concept.collection"]},
    {"id": "javascript.function.array-includes", "symbol": ".includes()", "name": "Array.prototype.includes", "aliases": ["includes", "포함 여부", "배열에 있는지"], "category": "array", "description": "배열에 특정 값이 들어 있는지 true/false로 알려 줍니다. 문자열에도 같은 이름의 메서드가 있습니다.", "syntax": "ARRAY.includes(VALUE)", "examples": ["[1, 2, 3].includes(2) // true"], "related": ["javascript.function.array-find", "python.operator.in"], "concepts": ["concept.collection"]},
    {"id": "javascript.function.array-some", "symbol": ".some()", "name": "Array.prototype.some", "aliases": ["some", "하나라도 만족", "any"], "category": "array", "description": "조건을 만족하는 요소가 하나라도 있으면 true를 반환합니다.", "syntax": "ARRAY.some(item => CONDITION)", "examples": ["[1, 2, 3].some(n => n > 2) // true"], "related": ["javascript.function.array-every", "python.function.any"], "concepts": ["concept.collection", "concept.boolean-logic"]},
    {"id": "javascript.function.array-every", "symbol": ".every()", "name": "Array.prototype.every", "aliases": ["every", "모두 만족", "all"], "category": "array", "description": "모든 요소가 조건을 만족해야 true를 반환합니다. 빈 배열은 true입니다.", "syntax": "ARRAY.every(item => CONDITION)", "examples": ["[2, 4].every(n => n % 2 === 0) // true"], "related": ["javascript.function.array-some", "python.function.all"], "concepts": ["concept.collection", "concept.boolean-logic"]},
    {"id": "javascript.function.array-slice", "symbol": ".slice()", "name": "Array.prototype.slice", "aliases": ["slice", "자르기", "부분 복사"], "category": "array", "description": "시작 인덱스부터 끝 인덱스 직전까지를 새 배열로 복사합니다. 원본은 바뀌지 않습니다. 음수 인덱스는 뒤에서부터 셉니다.", "syntax": "ARRAY.slice(START, END)", "examples": ["[1, 2, 3, 4].slice(1, 3) // [2, 3]", "[1, 2, 3].slice(-2) // [2, 3]"], "related": ["javascript.function.array-push"], "concepts": ["concept.collection"]},
    {"id": "javascript.function.array-push", "symbol": ".push()", "name": "Array.prototype.push", "aliases": ["push", "뒤에 추가", "추가"], "category": "array", "description": "배열 끝에 요소를 추가하고 새 길이를 반환합니다. 원본이 바뀝니다.", "syntax": "ARRAY.push(ITEM, ...)", "examples": ["const a = [1]; a.push(2); // a = [1, 2]"], "related": ["javascript.function.array-pop", "javascript.function.array-slice"], "concepts": ["concept.collection"]},
    {"id": "javascript.function.array-pop", "symbol": ".pop()", "name": "Array.prototype.pop", "aliases": ["pop", "마지막 꺼내기", "뒤에서 제거"], "category": "array", "description": "배열 마지막 요소를 제거하고 그 값을 반환합니다. 원본이 바뀝니다.", "syntax": "ARRAY.pop()", "examples": ["[1, 2, 3].pop() // 3"], "related": ["javascript.function.array-push"], "concepts": ["concept.collection"]},
    {"id": "javascript.function.array-sort", "symbol": ".sort()", "name": "Array.prototype.sort", "aliases": ["sort", "정렬", "소트"], "category": "array", "description": "배열을 제자리에서 정렬합니다. 비교 함수를 주지 않으면 요소를 문자열로 바꿔 정렬하므로 숫자는 (a, b) => a - b를 넘겨야 합니다.", "syntax": "ARRAY.sort((a, b) => NUMBER)", "examples": ["[10, 9, 1].sort((a, b) => a - b) // [1, 9, 10]"], "related": ["python.function.sorted", "javascript.function.array-map"], "concepts": ["concept.collection"]},
    {"id": "javascript.function.array-join", "symbol": ".join()", "name": "Array.prototype.join", "aliases": ["join", "합치기", "배열을 문자열로"], "category": "array", "description": "배열 요소를 구분자로 이어 붙인 문자열을 만듭니다. 기본 구분자는 쉼표입니다.", "syntax": "ARRAY.join(SEPARATOR)", "examples": ["[\"a\", \"b\"].join(\"-\") // \"a-b\""], "related": ["javascript.function.string-split"], "concepts": ["concept.collection", "concept.string"]},
    {"id": "javascript.function.array-flat", "symbol": ".flat()", "name": "Array.prototype.flat", "aliases": ["flat", "평탄화", "중첩 배열 펼치기"], "category": "array", "description": "중첩 배열을 지정한 깊이만큼 펼쳐 새 배열로 만듭니다. 기본 깊이는 1입니다.", "syntax": "ARRAY.flat(DEPTH)", "examples": ["[1, [2, [3]]].flat() // [1, 2, [3]]", "[1, [2, [3]]].flat(Infinity) // [1, 2, 3]"], "related": ["javascript.function.array-map"], "concepts": ["concept.collection"]},
    {"id": "javascript.function.array-from", "symbol": "Array.from()", "name": "Array.from", "aliases": ["Array from", "배열로 변환", "이터러블을 배열로"], "category": "array", "description": "유사 배열이나 반복 가능한 객체로 새 배열을 만듭니다. 두 번째 인자로 변환 함수를 줄 수 있습니다.", "syntax": "Array.from(ITERABLE, MAPFN)", "examples": ["Array.from(\"abc\") // [\"a\", \"b\", \"c\"]", "Array.from({ length: 3 }, (_, i) => i) // [0, 1, 2]"], "related": ["javascript.function.array-map", "javascript.operator.spread"], "concepts": ["concept.collection"]},
    {"id": "javascript.function.string-split", "symbol": ".split()", "name": "String.prototype.split", "aliases": ["split", "문자열 나누기", "쪼개기"], "category": "string", "description": "구분자 기준으로 문자열을 나눠 배열로 반환합니다.", "syntax": "STRING.split(SEPARATOR)", "examples": ["\"a,b,c\".split(\",\") // [\"a\", \"b\", \"c\"]"], "related": ["javascript.function.array-join", "python.function.str-split"], "concepts": ["concept.string"]},
    {"id": "javascript.function.string-trim", "symbol": ".trim()", "name": "String.prototype.trim", "aliases": ["trim", "공백 제거", "앞뒤 공백"], "category": "string", "description": "문자열 양쪽 끝의 공백(공백·탭·줄바꿈)을 제거한 새 문자열을 반환합니다.", "syntax": "STRING.trim()", "examples": ["\"  hi  \".trim() // \"hi\""], "related": ["javascript.function.string-split"], "concepts": ["concept.string"]},
    {"id": "javascript.function.string-replaceall", "symbol": ".replaceAll()", "name": "String.prototype.replaceAll", "aliases": ["replaceAll", "모두 바꾸기", "치환"], "category": "string", "description": "일치하는 모든 부분을 다른 문자열로 바꾼 새 문자열을 반환합니다. 정규식을 쓰면 g 플래그가 필요합니다.", "syntax": "STRING.replaceAll(SEARCH, REPLACEMENT)", "examples": ["\"a-b-c\".replaceAll(\"-\", \"+\") // \"a+b+c\""], "related": ["javascript.function.string-split"], "concepts": ["concept.string"]},
    {"id": "javascript.function.string-startswith", "symbol": ".startsWith()", "name": "String.prototype.startsWith", "aliases": ["startsWith", "시작 확인", "접두사 확인"], "category": "string", "description": "문자열이 특정 문자열로 시작하는지 검사합니다. 끝은 endsWith()입니다.", "syntax": "STRING.startsWith(SEARCH)", "examples": ["\"hello\".startsWith(\"he\") // true"], "related": ["javascript.function.array-includes"], "concepts": ["concept.string"]},
    {"id": "javascript.function.object-entries", "symbol": "Object.entries()", "name": "Object.entries", "aliases": ["entries", "키 값 쌍", "객체 순회"], "category": "object", "description": "객체의 [키, 값] 쌍 배열을 반환합니다. for...of와 구조분해로 객체를 순회할 때 편리합니다.", "syntax": "Object.entries(OBJECT)", "examples": ["Object.entries({ a: 1, b: 2 }) // [[\"a\", 1], [\"b\", 2]]"], "related": ["javascript.function.object-keys", "javascript.grammar.destructuring"], "concepts": ["concept.collection"]},
    {"id": "javascript.function.promise-all", "symbol": "Promise.all()", "name": "Promise.all", "aliases": ["프로미스 올", "병렬 대기", "모두 완료"], "category": "async", "description": "여러 Promise가 모두 이행될 때까지 기다려 결과 배열을 반환합니다. 하나라도 거부되면 즉시 거부됩니다.", "syntax": "Promise.all(ITERABLE)", "examples": ["const [a, b] = await Promise.all([fetch(\"/a\"), fetch(\"/b\")]);"], "related": ["javascript.keyword.await", "javascript.function.fetch"], "concepts": ["concept.concurrency"]},
    {"id": "javascript.function.math-max", "symbol": "Math.max()", "name": "Math.max", "aliases": ["최댓값", "가장 큰 수"], "category": "number", "description": "인자 중 가장 큰 수를 반환합니다. 배열은 Math.max(...arr)처럼 펼쳐서 넘깁니다. 인자가 없으면 -Infinity입니다.", "syntax": "Math.max(A, B, ...)", "examples": ["Math.max(1, 5, 3) // 5", "Math.max(...[2, 9, 4]) // 9"], "related": ["javascript.operator.spread", "javascript.function.parse-int"], "concepts": ["concept.aggregation"]},
    {"id": "javascript.function.structured-clone", "symbol": "structuredClone()", "name": "structuredClone", "aliases": ["깊은 복사", "딥 카피", "객체 복제"], "category": "object", "description": "객체를 깊게 복사합니다. 함수나 DOM 노드는 복사할 수 없고 오류가 납니다.", "syntax": "structuredClone(VALUE)", "examples": ["const copy = structuredClone({ a: { b: 1 } });"], "related": ["javascript.operator.spread"], "concepts": []}
  ]
}
