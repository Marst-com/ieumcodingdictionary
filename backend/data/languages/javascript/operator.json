{
  "schemaVersion": "1.0.0", "language": "javascript", "type": "operator", "entryVersion": "1.0.0",
  "entries": [
    {"id":"javascript.operator.strict-equality","symbol":"===","name":"Strict Equality","aliases":["엄격한 동등 비교","일치 연산자","삼중 등호","같다"],"category":"comparison","description":"값과 타입을 함께 비교합니다. 타입 변환을 하지 않습니다.","syntax":"A === B","examples":["x === 10","\"5\" === 5 // false"],"related":["javascript.operator.loose-equality","javascript.operator.strict-inequality"],"concepts":["concept.comparison"]},
    {"id":"javascript.operator.loose-equality","symbol":"==","name":"Loose Equality","aliases":["느슨한 동등 비교","동등 연산자","이중 등호"],"category":"comparison","description":"타입이 다르면 변환한 뒤 비교합니다. 예상치 못한 결과가 나올 수 있어 보통 ===를 씁니다.","syntax":"A == B","examples":["\"5\" == 5 // true","null == undefined // true"],"related":["javascript.operator.strict-equality"],"concepts":["concept.comparison"]},
    {"id":"javascript.operator.strict-inequality","symbol":"!==","name":"Strict Inequality","aliases":["엄격한 부등 비교","불일치 연산자","같지 않다"],"category":"comparison","description":"값 또는 타입이 다르면 true. ===의 반대입니다.","syntax":"A !== B","examples":["status !== \"done\""],"related":["javascript.operator.strict-equality"],"concepts":["concept.comparison"]},
    {"id":"javascript.operator.arrow","symbol":"=>","name":"Arrow Function","aliases":["화살표 함수","애로우 함수","람다"],"category":"function","description":"짧게 함수를 쓰는 문법. 자신의 this를 만들지 않고 바깥 this를 씁니다. 본문이 식 하나면 return을 생략할 수 있습니다.","syntax":"(PARAMS) => EXPRESSION","examples":["const double = n => n * 2;","items.map(x => x.id)"],"related":["javascript.grammar.arrow-function","javascript.keyword.function","javascript.keyword.this"],"concepts":["concept.function"]},
    {"id":"javascript.operator.nullish-coalescing","symbol":"??","name":"Nullish Coalescing","aliases":["널 병합","널 병합 연산자","기본값"],"category":"logical","description":"왼쪽이 null 또는 undefined일 때만 오른쪽 값을 사용합니다. 0이나 빈 문자열은 그대로 유지됩니다.","syntax":"A ?? B","examples":["const port = config.port ?? 3000;"],"related":["javascript.operator.logical-or","javascript.operator.optional-chaining"],"concepts":["concept.boolean-logic"]},
    {"id":"javascript.operator.optional-chaining","symbol":"?.","name":"Optional Chaining","aliases":["옵셔널 체이닝","안전한 접근"],"category":"access","description":"값이 null 또는 undefined면 에러 대신 undefined를 반환하고 접근을 멈춥니다.","syntax":"A?.B  A?.[KEY]  A?.()","examples":["user?.profile?.name"],"related":["javascript.operator.nullish-coalescing"],"concepts":[]},
    {"id":"javascript.operator.logical-and","symbol":"&&","name":"Logical AND","aliases":["논리곱","그리고","and"],"category":"logical","description":"둘 다 참이면 참. 왼쪽이 거짓이면 오른쪽을 평가하지 않고 왼쪽 값을 반환합니다.","syntax":"A && B","examples":["isLogin && showMenu()"],"related":["javascript.operator.logical-or","javascript.operator.logical-not"],"concepts":["concept.boolean-logic"]},
    {"id":"javascript.operator.logical-or","symbol":"||","name":"Logical OR","aliases":["논리합","또는","or"],"category":"logical","description":"하나라도 참이면 참. 왼쪽이 참이면 오른쪽을 평가하지 않고 왼쪽 값을 반환합니다.","syntax":"A || B","examples":["const name = input || \"익명\";"],"related":["javascript.operator.logical-and","javascript.operator.nullish-coalescing"],"concepts":["concept.boolean-logic"]},
    {"id":"javascript.operator.logical-not","symbol":"!","name":"Logical NOT","aliases":["논리 부정","not","느낌표"],"category":"logical","description":"값을 불리언으로 바꾼 뒤 뒤집습니다. !!값 으로 불리언 변환에도 씁니다.","syntax":"!A","examples":["if (!ready) return;"],"related":["javascript.operator.logical-and","javascript.operator.logical-or"],"concepts":["concept.boolean-logic"]},
    {"id":"javascript.operator.spread","symbol":"...","name":"Spread / Rest","aliases":["스프레드","전개 연산자","나머지 매개변수","rest"],"category":"collection","description":"배열·객체를 펼치거나(spread), 남은 인자를 하나의 배열로 모읍니다(rest).","syntax":"[...ARRAY]  {...OBJECT}  function f(...ARGS) {}","examples":["const copy = [...list, 4];","const merged = { ...a, ...b };"],"related":["javascript.function.array-map"],"concepts":["concept.collection"]},
    {"id":"javascript.operator.ternary","symbol":"?:","name":"Conditional (Ternary)","aliases":["삼항 연산자","조건 연산자","물음표 콜론"],"category":"conditional","description":"조건에 따라 두 값 중 하나를 선택하는 식.","syntax":"CONDITION ? A : B","examples":["const label = count > 0 ? \"있음\" : \"없음\";"],"related":["javascript.keyword.if"],"concepts":["concept.conditional"]},
    {"id":"javascript.operator.increment","symbol":"++","name":"Increment","aliases":["증가 연산자","1 증가","plus plus"],"category":"arithmetic","description":"값을 1 증가시킵니다. 변수 앞(++i)이면 증가 후 값을, 뒤(i++)면 증가 전 값을 반환합니다.","syntax":"i++  ++i","examples":["for (let i = 0; i < 5; i++) { }"],"related":["javascript.keyword.for"],"concepts":[]},
    {"id":"javascript.operator.exponent","symbol":"**","name":"Exponentiation","aliases":["거듭제곱","제곱","power"],"category":"arithmetic","description":"왼쪽 값을 오른쪽 값만큼 거듭제곱합니다.","syntax":"BASE ** EXPONENT","examples":["2 ** 10 // 1024"],"related":[],"concepts":[]},
    {"id":"javascript.operator.remainder","symbol":"%","name":"Remainder","aliases":["나머지","나머지 연산자","모듈로","mod"],"category":"arithmetic","description":"나눈 나머지를 구합니다. 부호는 왼쪽 피연산자를 따릅니다(-5 % 3은 -2). 짝수 판별 n % 2 === 0에 자주 씁니다.","syntax":"A % B","examples":["7 % 3 // 1","n % 2 === 0"],"related":["javascript.operator.exponent","python.operator.floor-divide"],"concepts":[]},
    {"id":"javascript.operator.addition","symbol":"+","name":"Addition / Concatenation","aliases":["더하기","덧셈","문자열 연결","플러스"],"category":"arithmetic","description":"숫자는 더하고, 피연산자 중 하나가 문자열이면 이어 붙입니다. 단항 +는 값을 숫자로 바꿉니다.","syntax":"A + B","examples":["1 + 2 // 3","\"a\" + 1 // \"a1\"","+\"42\" // 42"],"related":["javascript.operator.add-assign"],"concepts":["concept.string"]},
    {"id":"javascript.operator.assignment","symbol":"=","name":"Assignment","aliases":["대입","할당","등호"],"category":"assignment","description":"오른쪽 값을 왼쪽 변수나 속성에 저장합니다. 비교가 아닙니다. 비교에는 ===를 씁니다.","syntax":"TARGET = VALUE","examples":["let a = 1;","a = a + 1;"],"related":["javascript.operator.strict-equality","javascript.operator.add-assign","common.symbol.equals"],"concepts":["concept.variable"]},
    {"id":"javascript.operator.add-assign","symbol":"+=","name":"Addition Assignment","aliases":["더해서 대입","복합 대입","증가 대입"],"category":"assignment","description":"왼쪽 값에 오른쪽을 더해 다시 저장합니다. a += b는 a = a + b와 같습니다. -=, *=, /= 등도 같은 방식입니다.","syntax":"A += B","examples":["let total = 0; total += 5;","let s = \"a\"; s += \"b\";"],"related":["javascript.operator.assignment","javascript.operator.addition"],"concepts":["concept.variable"]},
    {"id":"javascript.operator.less-than","symbol":"<","name":"Less Than","aliases":["작다","미만"],"category":"comparison","description":"왼쪽이 오른쪽보다 작으면 true. 문자열끼리는 사전 순서로 비교합니다.","syntax":"A < B","examples":["1 < 2 // true"],"related":["javascript.operator.greater-than","javascript.operator.less-equal"],"concepts":["concept.comparison"]},
    {"id":"javascript.operator.greater-than","symbol":">","name":"Greater Than","aliases":["크다","초과"],"category":"comparison","description":"왼쪽이 오른쪽보다 크면 true.","syntax":"A > B","examples":["3 > 2 // true"],"related":["javascript.operator.less-than","javascript.operator.greater-equal"],"concepts":["concept.comparison"]},
    {"id":"javascript.operator.less-equal","symbol":"<=","name":"Less Than or Equal","aliases":["작거나 같다","이하"],"category":"comparison","description":"왼쪽이 오른쪽보다 작거나 같으면 true.","syntax":"A <= B","examples":["2 <= 2 // true"],"related":["javascript.operator.less-than","javascript.operator.greater-equal"],"concepts":["concept.comparison"]},
    {"id":"javascript.operator.greater-equal","symbol":">=","name":"Greater Than or Equal","aliases":["크거나 같다","이상"],"category":"comparison","description":"왼쪽이 오른쪽보다 크거나 같으면 true.","syntax":"A >= B","examples":["age >= 18"],"related":["javascript.operator.greater-than","javascript.operator.less-equal"],"concepts":["concept.comparison"]},
    {"id":"javascript.operator.bitwise-and","symbol":"&","name":"Bitwise AND","aliases":["비트 AND","비트곱","앤드 비트"],"category":"bitwise","description":"두 정수의 비트를 자리별로 AND 합니다. 논리 연산자 &&와 다릅니다.","syntax":"A & B","examples":["5 & 3 // 1","flags & 4"],"related":["javascript.operator.bitwise-or","javascript.operator.logical-and"],"concepts":[]},
    {"id":"javascript.operator.bitwise-or","symbol":"|","name":"Bitwise OR","aliases":["비트 OR","비트합"],"category":"bitwise","description":"두 정수의 비트를 자리별로 OR 합니다. 논리 연산자 ||와 다릅니다.","syntax":"A | B","examples":["5 | 2 // 7","flags | 4"],"related":["javascript.operator.bitwise-and","javascript.operator.logical-or"],"concepts":[]},
    {"id":"javascript.operator.left-shift","symbol":"<<","name":"Left Shift","aliases":["왼쪽 시프트","비트 이동"],"category":"bitwise","description":"비트를 왼쪽으로 옮깁니다. 1 << n은 2의 n제곱입니다(32비트 정수 범위).","syntax":"A << N","examples":["1 << 4 // 16"],"related":["javascript.operator.bitwise-and","javascript.operator.exponent"],"concepts":[]},
    {"id":"javascript.operator.nullish-assign","symbol":"??=","name":"Nullish Assignment","aliases":["널 병합 대입","기본값 대입"],"category":"assignment","description":"왼쪽이 null 또는 undefined일 때만 오른쪽 값을 대입합니다.","syntax":"A ??= B","examples":["config.port ??= 3000;"],"related":["javascript.operator.nullish-coalescing","javascript.operator.or-assign"],"concepts":["concept.null-value","concept.variable"]},
    {"id":"javascript.operator.or-assign","symbol":"||=","name":"Logical OR Assignment","aliases":["논리 OR 대입","거짓이면 대입"],"category":"assignment","description":"왼쪽이 falsy일 때만 오른쪽 값을 대입합니다. 0이나 빈 문자열도 덮어쓰므로 주의하세요.","syntax":"A ||= B","examples":["name ||= \"익명\";"],"related":["javascript.operator.nullish-assign","javascript.operator.logical-or"],"concepts":["concept.boolean-logic","concept.variable"]}
  ]
}
