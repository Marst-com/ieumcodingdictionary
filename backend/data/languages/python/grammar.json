{
  "schemaVersion": "1.0.0", "language": "python", "type": "grammar", "entryVersion": "1.0.0",
  "entries": [
    {"id": "python.grammar.function-definition", "symbol": "def f():", "name": "Function Definition", "aliases": ["함수 정의문", "함수 정의 문법"], "category": "declaration", "description": "def, 이름, 매개변수, 콜론, 들여쓰기 본문으로 이루어진 함수 정의 문법.", "syntax": "def NAME(PARAMS):\n    BODY", "examples": ["def add(a, b):\n    return a + b"], "related": ["python.keyword.def", "python.keyword.return", "javascript.grammar.function-declaration"], "concepts": ["concept.function"], "tree": {"node": "FUNCTION_DEF", "children": [{"node": "KEYWORD", "text": "def"}, {"node": "IDENTIFIER", "text": "add"}, {"node": "PARAMETER_LIST", "text": "(a, b)"}, {"node": "COLON", "text": ":"}, {"node": "BLOCK", "children": [{"node": "RETURN_STATEMENT", "children": [{"node": "KEYWORD", "text": "return"}, {"node": "EXPRESSION", "text": "a + b"}]}]}]}},
    {"id": "python.grammar.if-statement", "symbol": "if :", "name": "If Statement", "aliases": ["if 문", "조건문 문법"], "category": "statement", "description": "if, elif, else 절로 이루어진 조건 문장. 각 절은 콜론과 들여쓰기 블록을 가집니다.", "syntax": "if A:\n    ...\nelif B:\n    ...\nelse:\n    ...", "examples": ["if score >= 60:\n    result = \"합격\"\nelse:\n    result = \"불합격\""], "related": ["python.keyword.if", "python.keyword.elif", "python.keyword.else", "javascript.grammar.if-statement"], "concepts": ["concept.conditional"], "tree": {"node": "IF_STATEMENT", "children": [{"node": "KEYWORD", "text": "if"}, {"node": "CONDITION", "text": "score >= 60"}, {"node": "BLOCK", "text": "result = \"합격\""}, {"node": "ELSE_CLAUSE", "children": [{"node": "KEYWORD", "text": "else"}, {"node": "BLOCK", "text": "result = \"불합격\""}]}]}},
    {"id": "python.grammar.for-loop", "symbol": "for in :", "name": "For Statement", "aliases": ["for 반복문", "for 문법"], "category": "statement", "description": "반복 가능한 객체의 요소를 변수에 하나씩 담아 블록을 실행하는 문장.", "syntax": "for TARGET in ITERABLE:\n    BODY", "examples": ["for i in range(3):\n    print(i)"], "related": ["python.keyword.for", "python.function.range", "javascript.grammar.for-loop"], "concepts": ["concept.loop"], "tree": {"node": "FOR_STATEMENT", "children": [{"node": "KEYWORD", "text": "for"}, {"node": "TARGET", "text": "i"}, {"node": "KEYWORD", "text": "in"}, {"node": "ITERABLE", "text": "range(3)"}, {"node": "BLOCK", "text": "print(i)"}]}},
    {"id": "python.grammar.class-definition", "symbol": "class :", "name": "Class Definition", "aliases": ["클래스 정의문", "클래스 정의 문법"], "category": "declaration", "description": "class, 이름, 선택적 부모 클래스, 메서드를 담은 들여쓰기 블록으로 이루어진 정의.", "syntax": "class NAME(PARENT):\n    def __init__(self):\n        ...", "examples": ["class Counter:\n    def __init__(self):\n        self.n = 0\n    def inc(self):\n        self.n += 1"], "related": ["python.keyword.class", "javascript.grammar.class-declaration"], "concepts": ["concept.class"], "tree": {"node": "CLASS_DEF", "children": [{"node": "KEYWORD", "text": "class"}, {"node": "IDENTIFIER", "text": "Counter"}, {"node": "CLASS_BODY", "children": [{"node": "METHOD", "text": "def __init__(self): self.n = 0"}, {"node": "METHOD", "text": "def inc(self): self.n += 1"}]}]}},
    {"id": "python.grammar.try-except", "symbol": "try: except:", "name": "Try Statement", "aliases": ["try except 문법", "예외 처리 문법", "catch 문법"], "category": "statement", "description": "try 블록의 예외를 except 절에서 처리하는 문장. else, finally 절은 선택입니다.", "syntax": "try:\n    BODY\nexcept ERROR as e:\n    HANDLER", "examples": ["try:\n    value = int(text)\nexcept ValueError as e:\n    print(e)"], "related": ["python.keyword.try", "python.keyword.raise", "javascript.grammar.try-catch"], "concepts": ["concept.error-handling"], "tree": {"node": "TRY_STATEMENT", "children": [{"node": "KEYWORD", "text": "try"}, {"node": "BLOCK", "text": "value = int(text)"}, {"node": "EXCEPT_CLAUSE", "children": [{"node": "KEYWORD", "text": "except"}, {"node": "EXCEPTION_TYPE", "text": "ValueError as e"}, {"node": "BLOCK", "text": "print(e)"}]}]}},
    {"id": "python.grammar.list-comprehension", "symbol": "[x for x in y]", "name": "List Comprehension", "aliases": ["리스트 컴프리헨션", "리스트 내포", "컴프리헨션"], "category": "expression", "description": "반복과 조건을 한 줄에 써서 새 리스트를 만드는 식. map·filter를 대체하는 파이썬다운 방식입니다.", "syntax": "[EXPRESSION for ITEM in ITERABLE if CONDITION]", "examples": ["[n * 2 for n in range(5) if n % 2 == 0] # [0, 4, 8]"], "related": ["python.function.map", "javascript.function.array-map", "javascript.function.array-filter"], "concepts": ["concept.collection", "concept.loop"], "tree": {"node": "LIST_COMPREHENSION", "children": [{"node": "EXPRESSION", "text": "n * 2"}, {"node": "FOR_CLAUSE", "children": [{"node": "KEYWORD", "text": "for"}, {"node": "TARGET", "text": "n"}, {"node": "KEYWORD", "text": "in"}, {"node": "ITERABLE", "text": "range(5)"}]}, {"node": "IF_CLAUSE", "children": [{"node": "KEYWORD", "text": "if"}, {"node": "CONDITION", "text": "n % 2 == 0"}]}]}},
    {"id": "python.grammar.with-statement", "symbol": "with :", "name": "With Statement", "aliases": ["with 문법", "컨텍스트 매니저 문법"], "category": "statement", "description": "컨텍스트 매니저의 진입과 종료를 자동으로 처리하는 문장. 블록을 벗어나면 정리 작업이 실행됩니다.", "syntax": "with EXPRESSION as NAME:\n    BODY", "examples": ["with open(\"a.txt\", encoding=\"utf-8\") as f:\n    data = f.read()"], "related": ["python.keyword.with", "python.function.open"], "concepts": [], "tree": {"node": "WITH_STATEMENT", "children": [{"node": "KEYWORD", "text": "with"}, {"node": "WITH_ITEM", "text": "open(\"a.txt\", encoding=\"utf-8\") as f"}, {"node": "BLOCK", "text": "data = f.read()"}]}},
    {"id": "python.grammar.f-string", "symbol": "f\"{x}\"", "name": "Formatted String Literal", "aliases": ["f-string", "f 문자열", "문자열 포매팅", "문자열 보간"], "category": "expression", "description": "문자열 앞에 f를 붙이고 {} 안에 식을 쓰면 값이 채워지는 문자열 리터럴. {값:.2f}처럼 서식을 지정할 수 있습니다.", "syntax": "f\"TEXT {EXPRESSION:FORMAT}\"", "examples": ["name = \"가온\"\nprint(f\"안녕 {name}\")", "f\"{3.14159:.2f}\" # '3.14'"], "related": ["python.function.str", "python.function.str-join", "common.symbol.curly-open", "common.symbol.backtick"], "concepts": ["concept.string"], "tree": {"node": "FORMATTED_STRING", "children": [{"node": "STRING_PART", "text": "안녕 "}, {"node": "REPLACEMENT_FIELD", "children": [{"node": "EXPRESSION", "text": "name"}]}]}},
    {"id": "python.grammar.match-statement", "symbol": "match :", "name": "Match Statement", "aliases": ["match 문", "패턴 매칭 문법"], "category": "statement", "description": "match 뒤 값을 여러 case 패턴과 순서대로 비교해 처음 일치한 블록만 실행합니다. _ 패턴은 나머지 모두와 일치합니다.", "syntax": "match SUBJECT:\n    case PATTERN if GUARD:\n        BODY", "examples": ["match point:\n    case (0, 0):\n        print(\"원점\")\n    case (x, 0):\n        print(\"x축\", x)\n    case _:\n        print(\"기타\")"], "related": ["python.keyword.match", "javascript.grammar.switch-statement"], "concepts": ["concept.conditional"], "tree": {"node": "MATCH_STATEMENT", "children": [{"node": "KEYWORD", "text": "match"}, {"node": "SUBJECT", "text": "point"}, {"node": "CASE_BLOCK", "children": [{"node": "PATTERN", "text": "(0, 0)"}, {"node": "BLOCK", "text": "print(\"원점\")"}]}, {"node": "CASE_BLOCK", "children": [{"node": "PATTERN", "text": "_"}, {"node": "BLOCK", "text": "print(\"기타\")"}]}]}},
    {"id": "python.grammar.decorator", "symbol": "@decorator", "name": "Decorator", "aliases": ["데코레이터 문법", "함수 장식"], "category": "declaration", "description": "함수나 클래스 정의 위에 @이름을 써서 그 대상을 다른 함수로 감싸 바꿉니다. @name 뒤의 def는 name(def된 함수)와 같습니다.", "syntax": "@DECORATOR\ndef NAME(PARAMS):\n    BODY", "examples": ["def shout(f):\n    return lambda: f().upper()\n\n@shout\ndef hi():\n    return \"hi\""], "related": ["python.operator.decorator", "python.keyword.def"], "concepts": ["concept.function"], "tree": {"node": "DECORATED_DEFINITION", "children": [{"node": "DECORATOR", "text": "@shout"}, {"node": "FUNCTION_DEF", "children": [{"node": "KEYWORD", "text": "def"}, {"node": "IDENTIFIER", "text": "hi"}, {"node": "BLOCK", "text": "return \"hi\""}]}]}},
    {"id": "python.grammar.async-function", "symbol": "async def", "name": "Coroutine Definition", "aliases": ["비동기 함수 정의", "async def 문법"], "category": "declaration", "description": "async def로 코루틴을 정의하고, 안에서 await로 다른 코루틴을 기다립니다. asyncio.run()으로 실행합니다.", "syntax": "async def NAME(PARAMS):\n    RESULT = await COROUTINE", "examples": ["import asyncio\n\nasync def main():\n    await asyncio.sleep(1)\n\nasyncio.run(main())"], "related": ["python.keyword.async", "python.keyword.await", "javascript.grammar.async-function"], "concepts": ["concept.function", "concept.concurrency"], "tree": {"node": "ASYNC_FUNCTION_DEF", "children": [{"node": "KEYWORD", "text": "async def"}, {"node": "IDENTIFIER", "text": "main"}, {"node": "BLOCK", "children": [{"node": "AWAIT_EXPRESSION", "text": "await asyncio.sleep(1)"}]}]}}
  ]
}
