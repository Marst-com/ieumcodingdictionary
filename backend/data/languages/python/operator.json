{
  "schemaVersion": "1.0.0", "language": "python", "type": "operator", "entryVersion": "1.0.0",
  "entries": [
    {"id":"python.operator.equal","symbol":"==","name":"Equal","aliases":["동등 비교","같다","이중 등호"],"category":"comparison","description":"두 값이 같은지 비교합니다. 숫자 1과 1.0처럼 타입이 달라도 값이 같으면 True입니다.","syntax":"A == B","examples":["x == 10","1 == 1.0 # True"],"related":["python.operator.not-equal","python.operator.is"],"concepts":["concept.comparison"]},
    {"id":"python.operator.not-equal","symbol":"!=","name":"Not Equal","aliases":["부등 비교","같지 않다"],"category":"comparison","description":"두 값이 다르면 True.","syntax":"A != B","examples":["status != \"done\""],"related":["python.operator.equal"],"concepts":["concept.comparison"]},
    {"id":"python.operator.is","symbol":"is","name":"Identity (is)","aliases":["동일 객체","is not","신원 비교"],"category":"comparison","description":"두 변수가 메모리상 같은 객체인지 비교합니다. None 비교에는 is None을 씁니다.","syntax":"A is B","examples":["if value is None:\n    ..."],"related":["python.operator.equal","python.keyword.none"],"concepts":["concept.comparison"]},
    {"id":"python.operator.and","symbol":"and","name":"and","aliases":["그리고","논리곱","논리 연산"],"category":"logical","description":"둘 다 참이면 참. 왼쪽이 거짓이면 오른쪽을 평가하지 않고 왼쪽 값을 반환합니다. JavaScript의 &&에 해당합니다.","syntax":"A and B","examples":["if age >= 18 and has_id:\n    ..."],"related":["python.operator.or","python.operator.not"],"concepts":["concept.boolean-logic"]},
    {"id":"python.operator.or","symbol":"or","name":"or","aliases":["또는","논리합","논리 연산"],"category":"logical","description":"하나라도 참이면 참. 왼쪽이 참이면 오른쪽을 평가하지 않고 왼쪽 값을 반환합니다. JavaScript의 ||에 해당합니다.","syntax":"A or B","examples":["name = input_name or \"익명\""],"related":["python.operator.and","python.operator.not"],"concepts":["concept.boolean-logic"]},
    {"id":"python.operator.not","symbol":"not","name":"not","aliases":["부정","논리 부정","아니다"],"category":"logical","description":"참과 거짓을 뒤집습니다. JavaScript의 !에 해당합니다.","syntax":"not A","examples":["if not items:\n    print(\"비어 있음\")"],"related":["python.operator.and","python.operator.or"],"concepts":["concept.boolean-logic"]},
    {"id":"python.operator.in","symbol":"in","name":"in","aliases":["포함 여부","멤버십","not in"],"category":"membership","description":"값이 리스트·문자열·딕셔너리 등에 들어 있는지 검사합니다. for 문의 in과는 다른 용도입니다.","syntax":"VALUE in CONTAINER","examples":["\"a\" in [\"a\", \"b\"] # True","\"py\" in \"python\" # True"],"related":["python.keyword.for"],"concepts":["concept.collection"]},
    {"id":"python.operator.floor-divide","symbol":"//","name":"Floor Division","aliases":["몫","정수 나눗셈","내림 나눗셈"],"category":"arithmetic","description":"나눈 결과를 내림한 몫을 구합니다. 나머지는 %로 구합니다.","syntax":"A // B","examples":["7 // 2 # 3","-7 // 2 # -4"],"related":["python.operator.power"],"concepts":[]},
    {"id":"python.operator.power","symbol":"**","name":"Power","aliases":["거듭제곱","제곱"],"category":"arithmetic","description":"왼쪽 값을 오른쪽 값만큼 거듭제곱합니다.","syntax":"BASE ** EXPONENT","examples":["2 ** 10 # 1024"],"related":["python.operator.floor-divide"],"concepts":[]},
    {"id":"python.operator.walrus","symbol":":=","name":"Assignment Expression","aliases":["바다코끼리 연산자","walrus","대입 표현식"],"category":"assignment","description":"식 안에서 값을 변수에 대입하고 그 값을 그대로 사용합니다. Python 3.8에서 추가되었습니다.","syntax":"(NAME := EXPRESSION)","examples":["if (n := len(items)) > 3:\n    print(n)"],"related":["python.function.len"],"concepts":["concept.variable"]},
    {"id":"python.operator.decorator","symbol":"@","name":"Decorator / Matmul","aliases":["데코레이터","골뱅이","행렬 곱"],"category":"function","description":"함수·클래스 정의 위에 써서 동작을 감싸는 데코레이터 문법입니다. 두 값 사이에 쓰면 행렬 곱 연산자입니다.","syntax":"@DECORATOR\ndef NAME(): ...","examples":["@staticmethod\ndef util():\n    ..."],"related":["python.keyword.def"],"concepts":["concept.function"]},
    {"id":"python.operator.modulo","symbol":"%","name":"Modulo","aliases":["나머지","나머지 연산자","모듈로","mod"],"category":"arithmetic","description":"나눈 나머지를 구합니다. 결과의 부호는 오른쪽 피연산자를 따릅니다(-5 % 3은 1). 옛 문자열 서식(\"%s\" % x)에도 쓰입니다.","syntax":"A % B","examples":["7 % 3 # 1","-5 % 3 # 1"],"related":["python.operator.floor-divide","javascript.operator.remainder"],"concepts":[]},
    {"id":"python.operator.add-assign","symbol":"+=","name":"Augmented Assignment","aliases":["복합 대입","더해서 대입","증가 대입"],"category":"assignment","description":"왼쪽 값에 오른쪽을 더해 다시 저장합니다. 리스트에서는 제자리에서 확장합니다. -=, *=, //= 등도 같은 방식입니다.","syntax":"A += B","examples":["total = 0\ntotal += 5","names = []\nnames += [\"a\"]"],"related":["python.operator.walrus","javascript.operator.add-assign"],"concepts":["concept.variable"]},
    {"id":"python.operator.less-than","symbol":"<","name":"Less Than","aliases":["작다","미만"],"category":"comparison","description":"왼쪽이 오른쪽보다 작으면 True. 1 < x < 10처럼 연쇄해서 쓸 수 있습니다.","syntax":"A < B","examples":["1 < 2 # True","0 < x < 10"],"related":["python.operator.greater-equal","python.operator.equal"],"concepts":["concept.comparison"]},
    {"id":"python.operator.greater-equal","symbol":">=","name":"Greater Than or Equal","aliases":["크거나 같다","이상"],"category":"comparison","description":"왼쪽이 오른쪽보다 크거나 같으면 True.","syntax":"A >= B","examples":["age >= 18"],"related":["python.operator.less-than","python.operator.equal"],"concepts":["concept.comparison"]},
    {"id":"python.operator.star","symbol":"*","name":"Multiply / Unpack","aliases":["곱하기","별표","언패킹","반복","args"],"category":"arithmetic","description":"곱셈 연산자입니다. 시퀀스에는 반복(\"ab\" * 3)이고, 호출/정의에서는 *args 언패킹·가변 인자를 뜻합니다.","syntax":"A * B   *ITERABLE","examples":["\"ab\" * 3 # \"ababab\"","print(*[1, 2, 3])"],"related":["python.operator.power","javascript.operator.spread","common.symbol.asterisk"],"concepts":["concept.collection"]}
  ]
}
