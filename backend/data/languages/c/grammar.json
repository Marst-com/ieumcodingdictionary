    {"id":"c.grammar.function-definition","symbol":"int f() {}","name":"Function Definition","aliases":["함수 정의","함수 선언 문법"],"category":"declaration","description":"반환 타입, 이름, 매개변수 목록, 본문 블록으로 이루어진 함수 정의. 매개변수가 없으면 (void)라고 씁니다.","syntax":"RETURN_TYPE NAME(PARAMS) { BODY }","examples":["int add(int a, int b) {\n    return a + b;\n}"],"related":["c.keyword.return","c.keyword.void","javascript.grammar.function-declaration","python.grammar.function-definition"],"concepts":["concept.function"],"tree":{"node":"FUNCTION_DEFINITION","children":[{"node":"TYPE","text":"int"},{"node":"IDENTIFIER","text":"add"},{"node":"PARAMETER_LIST","text":"(int a, int b)"},{"node":"COMPOUND_STATEMENT","children":[{"node":"RETURN_STATEMENT","children":[{"node":"KEYWORD","text":"return"},{"node":"EXPRESSION","text":"a + b"}]}]}]}},
    {"id":"c.grammar.if-statement","symbol":"if () {}","name":"If Statement","aliases":["if 문 문법","조건문 문법"],"category":"statement","description":"조건식이 참이면 첫 문장을, 아니면 else 문장을 실행합니다. 조건식은 반드시 괄호 안에 씁니다.","syntax":"if (CONDITION) STATEMENT else STATEMENT","examples":["int x = 5;\nif (x > 3) {\n    x = 3;\n} else {\n    x = 0;\n}"],"related":["c.keyword.if","c.keyword.else","javascript.grammar.if-statement","python.grammar.if-statement"],"concepts":["concept.conditional"],"tree":{"node":"IF_STATEMENT","children":[{"node":"KEYWORD","text":"if"},{"node":"CONDITION","text":"(x > 3)"},{"node":"COMPOUND_STATEMENT","text":"{ x = 3; }"},{"node":"ELSE_CLAUSE","children":[{"node":"KEYWORD","text":"else"},{"node":"COMPOUND_STATEMENT","text":"{ x = 0; }"}]}]}},
    {"id":"c.grammar.for-loop","symbol":"for (;;) {}","name":"For Statement","aliases":["for 문 문법","반복문 문법"],"category":"statement","description":"초기화, 조건, 증감 세 부분과 본문으로 이루어진 반복 문장.","syntax":"for (INIT; TEST; UPDATE) STATEMENT","examples":["int sum = 0;\nfor (int i = 1; i <= 3; i++) {\n    sum += i;\n}"],"related":["c.keyword.for","javascript.grammar.for-loop","python.grammar.for-loop"],"concepts":["concept.loop"],"tree":{"node":"FOR_STATEMENT","children":[{"node":"KEYWORD","text":"for"},{"node":"INIT","text":"int i = 1"},{"node":"TEST","text":"i <= 3"},{"node":"UPDATE","text":"i++"},{"node":"COMPOUND_STATEMENT","text":"{ sum += i; }"}]}},
    {"id":"c.grammar.struct-definition","symbol":"struct {}","name":"Struct Definition","aliases":["구조체 정의 문법","구조체 선언"],"category":"declaration","description":"struct 키워드, 태그 이름, 멤버 선언 목록으로 이루어진 구조체 정의. 끝의 세미콜론을 빠뜨리기 쉽습니다.","syntax":"struct TAG {\n    TYPE MEMBER;\n};","examples":["struct Point {\n    int x;\n    int y;\n};"],"related":["c.keyword.struct","c.keyword.typedef","c.operator.arrow"],"concepts":["concept.data-type"],"tree":{"node":"STRUCT_SPECIFIER","children":[{"node":"KEYWORD","text":"struct"},{"node":"IDENTIFIER","text":"Point"},{"node":"MEMBER_LIST","children":[{"node":"MEMBER_DECLARATION","text":"int x;"},{"node":"MEMBER_DECLARATION","text":"int y;"}]}]}}
  ]
