    {"id":"c.type.size-t","symbol":"size_t","name":"size_t","aliases":["사이즈 티","크기 타입"],"category":"integer","description":"객체의 크기나 배열 인덱스를 나타내는 부호 없는 정수 타입. sizeof와 strlen의 결과 타입입니다.","syntax":"#include <stddef.h>\nsize_t NAME;","examples":["size_t n = sizeof(int);"],"related":["c.keyword.sizeof","c.function.strlen","c.keyword.unsigned"],"concepts":["concept.data-type"]},
    {"id":"c.type.int32-t","symbol":"int32_t","name":"int32_t","aliases":["고정 폭 정수","32비트 정수","stdint"],"category":"integer","description":"정확히 32비트 부호 있는 정수. 플랫폼에 상관없이 크기가 같아야 할 때 씁니다. uint8_t, int64_t 등도 있습니다.","syntax":"#include <stdint.h>\nint32_t NAME;","examples":["int32_t id = 42;"],"related":["c.keyword.int","c.type.size-t"],"concepts":["concept.data-type"]},
