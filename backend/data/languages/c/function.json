{
  "schemaVersion": "1.0.0", "language": "c", "type": "function", "entryVersion": "1.0.0",
  "entries": [
    {"id":"c.function.printf","symbol":"printf()","name":"printf","aliases":["출력","프린트","서식 출력"],"category":"io","description":"서식 문자열(%d, %s, %f 등)에 따라 표준 출력에 값을 씁니다.","syntax":"#include <stdio.h>\nint printf(const char *format, ...);","examples":["printf(\"%d + %d = %d\\n\", 1, 2, 3);"],"related":["c.function.scanf","c.preprocessor.include"],"concepts":["concept.string"]},
    {"id":"c.function.scanf","symbol":"scanf()","name":"scanf","aliases":["입력","서식 입력","키보드 입력"],"category":"io","description":"표준 입력에서 서식에 맞춰 값을 읽어 변수의 주소에 저장합니다. 반환값(성공한 항목 수)을 확인하는 것이 안전합니다.","syntax":"#include <stdio.h>\nint scanf(const char *format, ...);","examples":["int n;\nif (scanf(\"%d\", &n) != 1) { n = 0; }"],"related":["c.function.printf","c.operator.address-of"],"concepts":[]},
    {"id":"c.function.malloc","symbol":"malloc()","name":"malloc","aliases":["동적 할당","메모리 할당","힙"],"category":"memory","description":"지정한 바이트 수의 메모리를 힙에 할당하고 포인터를 반환합니다. 실패하면 NULL이며, 다 쓴 뒤 free로 반드시 해제해야 합니다.","syntax":"#include <stdlib.h>\nvoid *malloc(size_t size);","examples":["int *a = malloc(5 * sizeof *a);\nif (a) { free(a); }"],"related":["c.function.free","c.keyword.sizeof","c.macro.null"],"concepts":["concept.data-type"]},
    {"id":"c.function.free","symbol":"free()","name":"free","aliases":["메모리 해제","해제"],"category":"memory","description":"malloc 등으로 할당한 메모리를 해제합니다. 같은 포인터를 두 번 해제하면 정의되지 않은 동작입니다. NULL을 넘기는 것은 안전합니다.","syntax":"#include <stdlib.h>\nvoid free(void *ptr);","examples":["char *s = malloc(8);\nfree(s);\ns = NULL;"],"related":["c.function.malloc","c.macro.null"],"concepts":[]},
    {"id":"c.function.strlen","symbol":"strlen()","name":"strlen","aliases":["문자열 길이","길이"],"category":"string","description":"널 문자 '\\0' 앞까지의 문자 개수를 반환합니다(널 문자는 제외). 시간이 문자열 길이에 비례하므로 반복문 조건에서 매번 부르지 않는 것이 좋습니다.","syntax":"#include <string.h>\nsize_t strlen(const char *s);","examples":["size_t n = strlen(\"hello\");"],"related":["c.function.strcpy","c.type.size-t"],"concepts":["concept.string"]},
    {"id":"c.function.strcpy","symbol":"strcpy()","name":"strcpy","aliases":["문자열 복사","복사"],"category":"string","description":"원본 문자열을 널 문자까지 대상 버퍼로 복사합니다. 대상 크기를 확인하지 않아 버퍼 오버플로의 흔한 원인이므로 크기가 정해진 경우 strncpy나 snprintf를 고려합니다.","syntax":"#include <string.h>\nchar *strcpy(char *dest, const char *src);","examples":["char buf[16];\nstrcpy(buf, \"abc\");"],"related":["c.function.strlen","c.function.memcpy"],"concepts":["concept.string"]},
    {"id":"c.function.strcmp","symbol":"strcmp()","name":"strcmp","aliases":["문자열 비교","사전순 비교"],"category":"string","description":"두 문자열을 사전순으로 비교해 같으면 0, 앞이 작으면 음수, 크면 양수를 반환합니다.","syntax":"#include <string.h>\nint strcmp(const char *a, const char *b);","examples":["int same = (strcmp(\"a\", \"a\") == 0);"],"related":["c.operator.equal","c.function.strlen"],"concepts":["concept.string","concept.comparison"]},
    {"id":"c.function.memcpy","symbol":"memcpy()","name":"memcpy","aliases":["메모리 복사","바이트 복사"],"category":"memory","description":"n바이트를 원본에서 대상으로 복사합니다. 두 영역이 겹치면 정의되지 않은 동작이므로 겹칠 때는 memmove를 씁니다.","syntax":"#include <string.h>\nvoid *memcpy(void *dest, const void *src, size_t n);","examples":["int a[3] = {1, 2, 3};\nint b[3];\nmemcpy(b, a, sizeof a);"],"related":["c.function.strcpy","c.keyword.sizeof"],"concepts":[]},
    {"id":"c.function.fopen","symbol":"fopen()","name":"fopen","aliases":["파일 열기","파일 입출력"],"category":"file","description":"파일을 열고 FILE 포인터를 반환합니다. 모드는 \"r\"(읽기), \"w\"(쓰기, 덮어씀), \"a\"(이어쓰기). 실패하면 NULL입니다.","syntax":"#include <stdio.h>\nFILE *fopen(const char *path, const char *mode);","examples":["FILE *f = fopen(\"a.txt\", \"r\");\nif (f) { fclose(f); }"],"related":["c.function.fclose","c.type.file","c.macro.null"],"concepts":[]},
    {"id":"c.function.fclose","symbol":"fclose()","name":"fclose","aliases":["파일 닫기"],"category":"file","description":"fopen으로 연 파일을 닫고 버퍼를 비웁니다.","syntax":"#include <stdio.h>\nint fclose(FILE *stream);","examples":["FILE *f = fopen(\"a.txt\", \"w\");\nif (f) fclose(f);"],"related":["c.function.fopen","c.type.file"],"concepts":[]},
    {"id":"c.function.sqrt","symbol":"sqrt()","name":"sqrt","aliases":["제곱근","루트"],"category":"math","description":"double의 제곱근을 반환합니다. 일부 환경에서는 링크할 때 -lm 옵션이 필요합니다.","syntax":"#include <math.h>\ndouble sqrt(double x);","examples":["double r = sqrt(16.0);"],"related":["c.keyword.double"],"concepts":[]}
  ]
}
