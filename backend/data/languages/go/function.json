  "entries": [
    {"id": "go.function.fmt-println", "symbol": "fmt.Println()", "name": "fmt.Println", "aliases": ["출력", "프린트", "콘솔 출력", "println"], "category": "io", "description": "값들을 공백으로 구분해 출력하고 줄바꿈합니다. 서식이 필요하면 Printf, 문자열로 받으려면 Sprintf를 씁니다.", "syntax": "import \"fmt\"\nfmt.Println(VALUES...)", "examples": ["fmt.Println(\"안녕\", 42)"], "related": ["go.function.fmt-printf", "go.function.fmt-sprintf"], "concepts": []},
    {"id": "go.function.fmt-printf", "symbol": "fmt.Printf()", "name": "fmt.Printf", "aliases": ["서식 출력", "포맷 출력", "printf"], "category": "io", "description": "%d, %s, %v, %.2f 같은 서식 지정자로 출력합니다. 줄바꿈은 직접 \\n을 넣어야 합니다. %v는 타입에 맞는 기본 형식입니다.", "syntax": "import \"fmt\"\nfmt.Printf(FORMAT, ARGS...)", "examples": ["fmt.Printf(\"%s님 %d점\\n\", \"가온\", 90)"], "related": ["go.function.fmt-println", "c.function.printf"], "concepts": ["concept.string"]},
    {"id": "go.function.fmt-sprintf", "symbol": "fmt.Sprintf()", "name": "fmt.Sprintf", "aliases": ["서식 문자열", "문자열 포맷", "sprintf"], "category": "string", "description": "서식에 따라 만든 문자열을 출력하지 않고 반환합니다.", "syntax": "import \"fmt\"\nfmt.Sprintf(FORMAT, ARGS...) string", "examples": ["s := fmt.Sprintf(\"%05d\", 42)\n_ = s"], "related": ["go.function.fmt-printf", "java.method.string-format"], "concepts": ["concept.string"]},
    {"id": "go.function.errors-new", "symbol": "errors.New()", "name": "errors.New", "aliases": ["에러 만들기", "오류 생성"], "category": "error", "description": "주어진 메시지를 가진 새 error 값을 만듭니다. 호출마다 서로 다른 값입니다.", "syntax": "import \"errors\"\nerrors.New(MESSAGE) error", "examples": ["func check(n int) error {\n\tif n < 0 {\n\t\treturn errors.New(\"음수는 안 됩니다\")\n\t}\n\treturn nil\n}"], "related": ["go.type.error", "go.grammar.if-err"], "concepts": ["concept.error-handling"]},
    {"id": "go.function.strings-split", "symbol": "strings.Split()", "name": "strings.Split", "aliases": ["문자열 나누기", "쪼개기", "split"], "category": "string", "description": "구분자 기준으로 문자열을 나눠 []string으로 돌려줍니다.", "syntax": "import \"strings\"\nstrings.Split(S, SEP) []string", "examples": ["parts := strings.Split(\"a,b,c\", \",\")\n_ = parts"], "related": ["go.type.string", "javascript.function.string-split", "python.function.str-split"], "concepts": ["concept.string"]},
    {"id": "go.function.strconv-atoi", "symbol": "strconv.Atoi()", "name": "strconv.Atoi", "aliases": ["문자열을 정수로", "정수 변환", "atoi"], "category": "conversion", "description": "문자열을 int로 변환하고 (값, error)를 돌려줍니다. 변환할 수 없으면 error가 nil이 아닙니다.", "syntax": "import \"strconv\"\nstrconv.Atoi(S) (int, error)", "examples": ["n, err := strconv.Atoi(\"42\")\n_, _ = n, err"], "related": ["go.grammar.if-err", "python.function.int"], "concepts": ["concept.error-handling", "concept.data-type"]},
    {"id": "go.function.sort-slice", "symbol": "sort.Slice()", "name": "sort.Slice", "aliases": ["정렬", "슬라이스 정렬", "sort"], "category": "collection", "description": "슬라이스를 less 함수(i번째가 j번째보다 앞이어야 하면 true)에 따라 제자리 정렬합니다.", "syntax": "import \"sort\"\nsort.Slice(S, func(i, j int) bool { ... })", "examples": ["nums := []int{3, 1, 2}\nsort.Slice(nums, func(i, j int) bool { return nums[i] < nums[j] })"], "related": ["javascript.function.array-sort", "python.function.sorted"], "concepts": ["concept.collection"]},
    {"id": "go.function.os-readfile", "symbol": "os.ReadFile()", "name": "os.ReadFile", "aliases": ["파일 읽기", "파일 전체 읽기"], "category": "file", "description": "파일 전체를 읽어 ([]byte, error)로 돌려줍니다. 작은 파일을 한 번에 읽을 때 씁니다(Go 1.16+).", "syntax": "import \"os\"\nos.ReadFile(PATH) ([]byte, error)", "examples": ["data, err := os.ReadFile(\"a.txt\")\nif err != nil {\n\treturn\n}\n_ = data"], "related": ["go.grammar.if-err", "c.function.fopen"], "concepts": ["concept.error-handling"]}
